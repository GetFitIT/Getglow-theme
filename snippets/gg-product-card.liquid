{%- comment -%}
  Getglow product card. Usage: {% render 'gg-product-card', product: p, sizes: '(max-width: 768px) 50vw, 25vw', terms: search.terms %}
  Styles live in snippet 'gg-product-card-styles' (render once per page section).
{%- endcomment -%}
{%- liquid
  assign color_option = nil
  for o in product.options_with_values
    assign oname = o.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = o
    endif
  endfor
  assign img2 = product.images[1]
-%}
<a href="{{ product.url }}" class="gg-pcard">
  <span class="gg-pcard__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 720 | image_tag:
        widths: '300, 450, 600, 720',
        sizes: sizes,
        loading: 'lazy',
        alt: product.featured_image.alt | default: product.title,
        class: 'gg-pcard__img' }}
    {%- endif -%}
    {%- if img2 -%}
      {{ img2 | image_url: width: 720 | image_tag: widths: '300, 450, 600, 720', sizes: sizes, loading: 'lazy', alt: '', class: 'gg-pcard__img gg-pcard__img--hover' }}
    {%- endif -%}
    {% render 'gg-card-price', product: product, mode: 'badge' %}
  </span>
  <span class="gg-pcard__body">
    <span class="gg-pcard__title">{{ product.title }}</span>
    <span class="gg-pcard__price">{% render 'gg-card-price', product: product %}</span>
    {%- if color_option and color_option.values.size > 1 -%}
      <span class="gg-pcard__swatches" aria-label="{{ color_option.values.size }} colours">
        {%- for v in color_option.values limit: 6 -%}
          <span class="gg-pcard__dot" style="background: {% render 'gg-swatch-bg', color: v %};" title="{{ v | escape }}"></span>
        {%- endfor -%}
        {%- if color_option.values.size > 6 -%}<span class="gg-pcard__more">+{{ color_option.values.size | minus: 6 }}</span>{%- endif -%}
      </span>
    {%- endif -%}
  </span>
</a>
