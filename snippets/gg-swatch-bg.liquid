{%- comment -%}
  Outputs a CSS background value for a colour option name.
  Usage: {% render 'gg-swatch-bg', color: value %}
{%- endcomment -%}
{%- liquid
  assign h = color | handle
  case h
    when 'black'
      echo '#111111'
    when 'white'
      echo '#ffffff'
    when 'cream', 'off-white', 'ivory'
      echo '#f3ead3'
    when 'nude', 'beige'
      echo '#e3bc9a'
    when 'peach'
      echo '#f6c4a4'
    when 'gold'
      echo 'linear-gradient(135deg, #b8901f 0%, #f1d77a 50%, #a67c12 100%)'
    when 'silver'
      echo 'linear-gradient(135deg, #9ea3a8 0%, #eef0f2 50%, #8d9297 100%)'
    when 'red'
      echo '#b3122e'
    when 'maroon', 'wine'
      echo '#6d1a2a'
    when 'burgundy'
      echo '#800020'
    when 'pink'
      echo '#e88fb3'
    when 'magenta', 'fuchsia'
      echo '#b0267a'
    when 'purple'
      echo '#6a2c91'
    when 'lilac', 'lavender'
      echo '#c4a8d8'
    when 'blue'
      echo '#1f5fbf'
    when 'navy', 'navy-blue'
      echo '#1b2440'
    when 'green'
      echo '#1f7a4a'
    when 'lemon-green', 'lime'
      echo '#c5d93c'
    when 'yellow'
      echo '#f2c230'
    when 'orange'
      echo '#ee7b22'
    when 'burnt-orange', 'rust'
      echo '#c1581d'
    when 'brown', 'chocolate'
      echo '#6b3f24'
    when 'gray', 'grey'
      echo '#8a8a8a'
    when 'polka', 'polka-dot'
      echo 'radial-gradient(#ffffff 22%, transparent 24%) 0 0 / 7px 7px, #111111'
    else
      echo color | downcase | remove: ' '
  endcase
-%}
