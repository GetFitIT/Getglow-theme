{% comment %} ============================================================
   JAVASCRIPT — Lazy Load + Scroll Reveal
============================================================ {% endcomment %}

<script>
(function() {
  'use strict';

  /* Lazy load images */
  var lazyImgs = document.querySelectorAll('.press-showcase .ps-lazy');
  if ('IntersectionObserver' in window) {
    var imgObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var el = entry.target;
          el.classList.add('ps-loaded');
          imgObserver.unobserve(el);
        }
      });
    }, { rootMargin: '200px 0px' });

    lazyImgs.forEach(function(img) { imgObserver.observe(img); });
  } else {
    lazyImgs.forEach(function(img) { img.classList.add('ps-loaded'); });
  }

  /* Scroll reveal */
  var revealEls = document.querySelectorAll('.press-showcase .ps-reveal');
  if ('IntersectionObserver' in window) {
    var revealObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('ps-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });

    revealEls.forEach(function(el) { revealObserver.observe(el); });
  } else {
    revealEls.forEach(function(el) { el.classList.add('ps-visible'); });
  }
})();
</script>


