<section class="gg-reels" id="gg-reels-{{ section.id }}">
  <div class="gg-wrap">
    <div class="gg-section-head">
      {%- if section.settings.heading != blank -%}<h2 class="gg-section-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="gg-section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="gg-reels__track">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <a class="gg-reel" href="{{ p.url | default: '#' }}" {{ block.shopify_attributes }}>
          <span class="gg-reel__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag:
                autoplay: true, loop: true, muted: true, playsinline: true, controls: false,
                preload: 'none', image_size: '540x', class: 'gg-reel__video' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(max-width: 768px) 62vw, 25vw', class: 'gg-reel__video' }}
            {%- elsif p.featured_image -%}
              {{ p.featured_image | image_url: width: 540 | image_tag: loading: 'lazy', class: 'gg-reel__video' }}
            {%- endif -%}
            {%- if block.settings.credit != blank -%}
              <span class="gg-reel__credit">{{ block.settings.credit }}</span>
            {%- endif -%}
          </span>
          {%- if p != blank -%}
            <span class="gg-reel__info">
              <span class="gg-reel__title">{{ block.settings.label | default: p.title }}</span>
              {%- if section.settings.show_price -%}
                <span class="gg-reel__price">{% render 'gg-card-price', product: p %}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% render 'gg-shared-styles' %}
<style>
  #gg-reels-{{ section.id }} { padding: 72px 0; }
  #gg-reels-{{ section.id }} .gg-reels__track {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns | default: 4 }}, minmax(0, 1fr));
    gap: 16px;
  }
  #gg-reels-{{ section.id }} { background: {{ section.settings.background | default: 'transparent' }}; }
  #gg-reels-{{ section.id }} .gg-reel { display: block; text-decoration: none; color: #1d1a16; }
  #gg-reels-{{ section.id }} .gg-reel__credit {
    position: absolute;
    left: 10px;
    bottom: 10px;
    z-index: 1;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  #gg-reels-{{ section.id }} .gg-reel__media {
    position: relative;
    display: block;
    aspect-ratio: 9 / 14;
    border-radius: 10px;
    overflow: hidden;
    background: #eee4d3;
  }
  #gg-reels-{{ section.id }} .gg-reel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #gg-reels-{{ section.id }} .gg-reel__info { display: flex; flex-direction: column; gap: 2px; padding: 12px 2px 0; }
  #gg-reels-{{ section.id }} .gg-reel__title { font-size: 15px; font-weight: 600; }
  #gg-reels-{{ section.id }} .gg-reel__price { font-size: 14px; color: #5c554a; }

  @media (max-width: 768px) {
    #gg-reels-{{ section.id }} { padding: 48px 0; }
    #gg-reels-{{ section.id }} .gg-reels__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 10px;
      margin: 0 -20px;
      padding: 0 20px 6px;
      scrollbar-width: none;
    }
    #gg-reels-{{ section.id }} .gg-reels__track::-webkit-scrollbar { display: none; }
    #gg-reels-{{ section.id }} .gg-reel { flex: 0 0 62%; scroll-snap-align: start; }
  }
</style>

<script>
  (function() {
    // Only play reels while they are on screen (saves data and battery on mobile)
    var root = document.getElementById('gg-reels-{{ section.id }}');
    if (!root || !('IntersectionObserver' in window)) return;
    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var videos = root.querySelectorAll('video');
    videos.forEach(function(v) { v.removeAttribute('autoplay'); v.pause(); });
    if (reduceMotion) return;
    var io = new IntersectionObserver(function(entries) {
      entries.forEach(function(e) {
        if (e.isIntersecting) {
          if (e.target.preload === 'none') e.target.preload = 'auto';
          var p = e.target.play(); if (p && p.catch) p.catch(function() {});
        } else {
          e.target.pause();
        }
      });
    }, { threshold: 0.35 });
    videos.forEach(function(v) { io.observe(v); });
  })();
</script>

{% schema %}
{
  "name": "Getglow see it move",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See it move" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Real fabric, real movement. Tap a look to shop it." },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_price", "label": "Show price", "default": true },
    { "type": "color", "id": "background", "label": "Background" }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Video",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Used when there is no video." },
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the product title." },
        { "type": "text", "id": "credit", "label": "Credit (e.g. @clienthandle)", "info": "Shown on the photo. Only credit clients who have agreed to be featured." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Getglow see it move" }]
}
{% endschema %}
