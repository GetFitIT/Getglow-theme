{% comment %}
  Section: Video Hero — Holiday Collection
  A full-width cinematic video hero with overlay text and CTA button.
  Mirrors the "Holiday '25 Collection: Èkó Èlan" aesthetic.
{% endcomment %}

<section
  id="section-{{ section.id }}"
  class="video-hero"
  style="
    --overlay-color: {{ section.settings.overlay_color }};
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --text-color: {{ section.settings.text_color }};
    --btn-bg: {{ section.settings.button_bg }};
    --btn-text: {{ section.settings.button_text_color }};
    --section-height: {{ section.settings.section_height }}vh;
  "
>
  {%- comment -%} ── VIDEO BACKGROUND ── {%- endcomment -%}
  <div class="video-hero__media">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          class: 'video-hero__video',
          preload: 'auto'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        class="video-hero__video"
        src="{{ section.settings.video_url }}"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
      ></video>
    {%- else -%}
      {%- if section.settings.fallback_image != blank -%}
        {{
          section.settings.fallback_image
          | image_url: width: 2400
          | image_tag: class: 'video-hero__fallback', loading: 'eager', fetchpriority: 'high'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'video-hero__fallback video-hero__placeholder' }}
      {%- endif -%}
    {%- endif -%}

    {%- comment -%} Colour overlay {%- endcomment -%}
    <div class="video-hero__overlay" aria-hidden="true"></div>
  </div>

  {%- comment -%} ── CONTENT ── {%- endcomment -%}
  <div class="video-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="video-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <{{ section.settings.heading_tag }} class="video-hero__heading">
        {{ section.settings.heading }}
      </{{ section.settings.heading_tag }}>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="video-hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="video-hero__cta-wrap">
        <a
          href="{{ section.settings.button_link }}"
          class="video-hero__btn"
          {% if section.settings.button_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  /* ─────────────────────────────────────────
     VIDEO HERO — base styles
  ───────────────────────────────────────── */
  #section-{{ section.id }}.video-hero {
  position: relative;
  width: 100%;
  height: var(--section-height, 100vh);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  margin-top: 40px; /* adjust value as needed */
}

  /* ── Media layer ── */
  #section-{{ section.id }} .video-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #section-{{ section.id }} .video-hero__video,
  #section-{{ section.id }} .video-hero__fallback {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #section-{{ section.id }} .video-hero__placeholder {
    width: 100%;
    height: 100%;
  }

  /* ── Overlay ── */
  #section-{{ section.id }} .video-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--overlay-color, #1a0800);
    opacity: var(--overlay-opacity, 0.35);
    pointer-events: none;
  }

  /* ── Content ── */
  #section-{{ section.id }} .video-hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: var(--text-color, #ffffff);
    padding: 0 1.5rem 6rem;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;

    /* subtle fade-up entrance */
    animation: heroFadeUp 1.1s cubic-bezier(0.22, 0.61, 0.36, 1) both;
    animation-delay: 0.2s;
  }

  #section-{{ section.id }} .video-hero__eyebrow {
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
    font-size: clamp(0.65rem, 1.2vw, 0.85rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    opacity: 0.75;
    margin: 0 0 0.75rem;
  }

  #section-{{ section.id }} .video-hero__heading {
    font-family: 'Didot', 'Bodoni MT', 'Playfair Display', Georgia, serif;
    font-size: clamp(1.4rem, 3.8vw, 2.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
    line-height: 1.15;
  }

  #section-{{ section.id }} .video-hero__subheading {
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
    font-size: clamp(0.7rem, 1.4vw, 0.9rem);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.85;
    margin: 0 0 2.4rem;
  }

  /* ── CTA Button ── */
  #section-{{ section.id }} .video-hero__cta-wrap {
    display: flex;
    justify-content: center;
  }

  #section-{{ section.id }} .video-hero__btn {
    display: inline-block;
    background: var(--btn-bg, rgba(255,255,255,0.15));
    color: var(--btn-text, #ffffff);
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, sans-serif;
    font-size: clamp(0.65rem, 1.2vw, 0.8rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    padding: 0.9rem 2.4rem;
    border: 1px solid rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    transition: background 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
    cursor: pointer;
  }

  #section-{{ section.id }} .video-hero__btn:hover {
    background: rgba(255, 255, 255, 0.28);
    border-color: rgba(255, 255, 255, 0.9);
    transform: translateY(-1px);
  }

  /* ── Entrance animation ── */
  @keyframes heroFadeUp {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Mobile adjustments ── */
  @media (max-width: 768px) {
    #section-{{ section.id }}.video-hero {
      height: {{ section.settings.mobile_height }}vh;
    }

    #section-{{ section.id }} .video-hero__content {
      padding-bottom: 4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Video Hero",
  "tag": "section",
  "class": "shopify-section--video-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Background video (Shopify-hosted)"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "External video URL (.mp4)",
      "info": "Used only when no Shopify-hosted video is selected above."
    },
    {
      "type": "image_picker",
      "id": "fallback_image",
      "label": "Fallback image",
      "info": "Displayed when no video is set, or on slow connections."
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#1a0800"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 35
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Holiday '25 Collection: Èkó Èlan"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Online and Instore"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#2c0f0f"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text colour",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "button_new_tab",
      "label": "Open link in new tab",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height (desktop)",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Section height (mobile)",
      "min": 40,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 75
    }
  ],
  "presets": [
    {
      "name": "Video Hero",
      "category": "Image and video"
    }
  ]
}
{% endschema %}
