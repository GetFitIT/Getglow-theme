<style>
  .product-page {
    padding: 2rem 0;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8rem;
    align-items: start;
  }

  /* Product Images */
  .product-images {
    display: flex;
    gap: 1rem;
    transition: opacity 0.2s ease-in-out;
  }

  .product-thumbnails {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .thumbnail-btn {
    width: 64px;
    height: 64px;
    border: 2px solid #d4af37;
    border-radius: 8px;
    overflow: hidden;
    background: none;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .thumbnail-btn:hover,
  .thumbnail-btn.active {
    border-color: #000;
  }

  .thumbnail-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-main-image {
    flex: 1;
    aspect-ratio: 3/4;
    background: #f5f5f5;
    border-radius: 8px;
    overflow: hidden;
  }

  .product-main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .desktop-only { display: block; }
  .mobile-only { display: none; }

  @media (max-width: 768px) {
  .product-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  .product-images {
    flex-direction: column;
  }

  .product-thumbnails {
    flex-direction: row;
    order: 2;
    flex-wrap: wrap; /* ADD THIS - prevents thumbnails from overflowing */
  }

  .product-main-image {
    order: 1;
    max-height: 520px; /* ADD THIS - limits image height on mobile */
  }

  .desktop-only { display: none; }
  .mobile-only { display: block; }

  /* Swipeable image slider (mobile) */
  .mobile-image-slider {
    width: 100%;
    height: 100%;
    position: relative;
  }

  .mobile-image-track {
    display: flex;
    width: 100%;
    height: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
    scrollbar-width: none; /* Firefox */
    /* Allow both swipe (x) and page scroll (y) */
    touch-action: pan-x pan-y pinch-zoom;
    overscroll-behavior-x: contain;
  }

  .mobile-image-track::-webkit-scrollbar { display: none; }

  .mobile-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
  }

  .mobile-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  .mobile-image-dots {
    position: absolute;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    display: flex;
    gap: 6px;
    padding: 6px 8px;
    background: rgba(0,0,0,0.25);
    border-radius: 999px;
    pointer-events: auto;
  }

  .mobile-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    border: 0;
    background: rgba(255,255,255,0.55);
    padding: 0;
  }

  .mobile-dot.active {
    background: rgba(255,255,255,0.95);
  }

  .btn-add-to-cart {
    width: 100%;
  }
}

