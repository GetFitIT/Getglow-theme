<!-- sections/product-template.liquid -->

<div class="product-page">
  <div class="container">
    <div class="product-grid">
      
      <!-- Left side - Product Images -->
      <div class="product-images">
        <!-- Thumbnail Images -->
        <div class="product-thumbnails">
          {% for image in product.images limit: 10 %}
            <button 
              class="thumbnail-btn {% if forloop.first %}active{% endif %}" 
              data-image-index="{{ forloop.index0 }}"
              data-image-src="{{ image | img_url: '800x800' }}"
              data-image-alt="{{ image.alt | escape }}"
              aria-label="View image {{ forloop.index }}"
            >
              <img src="{{ image | img_url: '100x100' }}" alt="{{ image.alt | default: product.title | escape }}" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <!-- Main Product Image (desktop) + Swipe Slider (mobile) -->
        <div class="product-main-image">
          <img 
            id="main-product-image"
            class="desktop-only"
            src="{{ product.featured_image | img_url: '800x800' }}" 
            alt="{{ product.title }}"
            data-zoom="{{ product.featured_image | img_url: '1200x1200' }}"
            onclick="openLightbox()"
          >

          <div class="mobile-image-slider mobile-only" aria-label="Product images">
            <div class="mobile-image-track" id="mobile-image-track">
              {% for image in product.images limit: 10 %}
                <div class="mobile-slide" data-image-index="{{ forloop.index0 }}">
                  <img
                    src="{{ image | img_url: '800x800' }}"
                    alt="{{ product.title }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    draggable="false"
                    data-zoom="{{ image | img_url: '1200x1200' }}"
                  >
                </div>
              {% endfor %}
            </div>

            <div class="mobile-image-dots">
              {% for image in product.images limit: 10 %}
                <button type="button" class="mobile-dot {% if forloop.first %}active{% endif %}" data-image-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"></button>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <!-- Right side - Product Details -->
      <div class="product-details">
        
        <!-- Product Title -->
        <h1 class="product-title">{{ product.title }}</h1>

        <!-- Product Price -->
        <div class="product-price">
          <span class="price">
            {% if product.compare_at_price > product.price %}
              <span class="sale-price">{{ product.price | money }}</span>
              <span class="original-price">{{ product.compare_at_price | money }}</span>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </span>
        </div>

        <!-- Add to Cart Success Message -->
        <div class="cart-success-message" id="cart-success-message" style="display: none;">
          <div class="success-content">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="success-icon">
              <path d="M16.667 5l-8.334 8.333-3.333-3.333" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Added to cart!</span>
          </div>
        </div>

        <!-- Product Form -->
        <form action="/cart/add" method="post" enctype="multipart/form-data" id="product-form">
          
       <!-- Mobile variant trigger (only shows on mobile) -->
       {% unless product.has_only_default_variant %}
         <button type="button" class="mobile-variant-trigger" id="mobile-variant-trigger" aria-haspopup="dialog" aria-controls="variant-sheet">
           <span class="mobile-variant-trigger-text" id="mobile-variant-trigger-text">SELECT OPTIONS</span>
         </button>
       {% endunless %}

       <!-- Product Variants -->
{% unless product.has_only_default_variant %}
  <div class="product-variants-wrapper" id="product-variants-wrapper">
    {% for option in product.options_with_values %}
      <div class="product-option">
        <div class="option-header">
          <span class="option-label">
            {{ option.name | upcase }}
            <span class="option-selected" data-option="{{ option.name }}">{{ option.selected_value | upcase }}</span>
          </span>
          {% if option.name == 'Size' and section.settings.show_size_guide %}
            <button type="button" class="size-guide-link" data-size-guide-open aria-haspopup="dialog" aria-controls="size-guide-modal">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 8.5 8.5 3 21 15.5 15.5 21 3 8.5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="m7 7 2 2M10 4.5l1.5 1.5M10 10l2 2M13 7.5 14.5 9M13 13l2 2M16 10.5l1.5 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              Size guide
            </button>
          {% endif %}
        </div>

        {% if option.name == 'Size' %}
          <div class="size-options">
            {% for value in option.values %}
              <input 
                type="radio" 
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="size-btn">
                {{ value }}
              </label>
            {% endfor %}
          </div>
        {% elsif option.name == 'Color' %}
          <div class="color-options">
            {% for value in option.values %}
              {%- liquid
                assign color_handle = value | handle
                case color_handle
                  when 'black'
                    assign swatch_bg = '#111111'
                  when 'white'
                    assign swatch_bg = '#ffffff'
                  when 'cream', 'off-white', 'ivory'
                    assign swatch_bg = '#f3ead3'
                  when 'nude', 'beige'
                    assign swatch_bg = '#e3bc9a'
                  when 'peach'
                    assign swatch_bg = '#f6c4a4'
                  when 'gold'
                    assign swatch_bg = 'linear-gradient(135deg, #b8901f 0%, #f1d77a 50%, #a67c12 100%)'
                  when 'silver'
                    assign swatch_bg = 'linear-gradient(135deg, #9ea3a8 0%, #eef0f2 50%, #8d9297 100%)'
                  when 'red'
                    assign swatch_bg = '#b3122e'
                  when 'maroon', 'wine'
                    assign swatch_bg = '#6d1a2a'
                  when 'burgundy'
                    assign swatch_bg = '#800020'
                  when 'pink'
                    assign swatch_bg = '#e88fb3'
                  when 'magenta', 'fuchsia'
                    assign swatch_bg = '#b0267a'
                  when 'purple'
                    assign swatch_bg = '#6a2c91'
                  when 'lilac', 'lavender'
                    assign swatch_bg = '#c4a8d8'
                  when 'blue'
                    assign swatch_bg = '#1f5fbf'
                  when 'navy', 'navy-blue'
                    assign swatch_bg = '#1b2440'
                  when 'green'
                    assign swatch_bg = '#1f7a4a'
                  when 'lemon-green', 'lime'
                    assign swatch_bg = '#c5d93c'
                  when 'mint-green', 'mint'
                    assign swatch_bg = '#9fe0c9'
                  when 'olive-green', 'olive', 'army-green'
                    assign swatch_bg = '#6b7a2a'
                  when 'dark-green'
                    assign swatch_bg = '#1e4d32'
                  when 'sky-blue', 'light-blue', 'baby-blue', 'aqua'
                    assign swatch_bg = '#8fd3ea'
                  when 'royal-blue'
                    assign swatch_bg = '#2747b8'
                  when 'bronze', 'copper'
                    assign swatch_bg = 'linear-gradient(135deg, #8a4f22 0%, #c8834a 50%, #7a4319 100%)'
                  when 'ash'
                    assign swatch_bg = '#b2b0ab'
                  when 'onion-purple'
                    assign swatch_bg = '#9b5a86'
                  when 'butter-yellow', 'lemon'
                    assign swatch_bg = '#f6e27f'
                  when 'yellow'
                    assign swatch_bg = '#f2c230'
                  when 'orange'
                    assign swatch_bg = '#ee7b22'
                  when 'burnt-orange', 'rust'
                    assign swatch_bg = '#c1581d'
                  when 'brown', 'chocolate'
                    assign swatch_bg = '#6b3f24'
                  when 'gray', 'grey'
                    assign swatch_bg = '#8a8a8a'
                  when 'polka', 'polka-dot'
                    assign swatch_bg = 'radial-gradient(#ffffff 22%, transparent 24%) 0 0 / 9px 9px, #111111'
                  else
                    assign swatch_bg = value | downcase | remove: ' '
                endcase
              -%}
              <input
                type="radio"
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="color-swatch{% if color_handle == 'white' or color_handle == 'cream' %} color-swatch--light{% endif %}"
                data-color="{{ color_handle }}"
                title="{{ value }}">
                <span class="color-swatch__chip" style="background: {{ swatch_bg }};"></span>
                <span class="sr-only">{{ value }}</span>
              </label>
            {% endfor %}
          </div>
        {% elsif option.name == 'Clothing features' %}
          <div class="size-options">
            {% for value in option.values %}
              <input 
                type="radio" 
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="size-btn">
                {{ value }}
              </label>
            {% endfor %}
          </div>
        {% else %}
          <select name="options[{{ option.name }}]" class="product-select" data-option-position="{{ option.position }}">
            {% for value in option.values %}
              <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>
                {{ value }}
              </option>
            {% endfor %}
          </select>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endunless %}

          <!-- Hidden variant ID -->
          <select name="id" id="product-variants" style="display: none;">
            {% for variant in product.variants %}
              {%- assign variant_image_index = '' -%}
              {%- if variant.featured_image -%}
                {%- for image in product.images limit: 10 -%}
                  {%- if image.id == variant.featured_image.id -%}{%- assign variant_image_index = forloop.index0 -%}{%- endif -%}
                {%- endfor -%}
              {%- endif -%}
              <option
                value="{{ variant.id }}"
                data-image-index="{{ variant_image_index }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price }}"
                data-compare-price="{{ variant.compare_at_price }}"
                data-option1="{{ variant.option1 }}"
                data-option2="{{ variant.option2 }}"
                data-option3="{{ variant.option3 }}"
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <!-- Tailored fit: guided custom measurements (optional) -->
          <div class="custom-size-wrapper">
            <button type="button" class="custom-size-toggle" id="custom-size-toggle" aria-expanded="false" aria-controls="custom-size-panel">
              <span class="custom-size-toggle__text">
                <strong>Tailored to you</strong>
                <span>Add your measurements for a made-to-measure fit (optional)</span>
              </span>
              <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="custom-size-panel" id="custom-size-panel" hidden>
              <div class="measure-unit" role="radiogroup" aria-label="Measurement unit">
                <label><input type="radio" name="measure_unit" value="in" checked> Inches</label>
                <label><input type="radio" name="measure_unit" value="cm"> Centimetres</label>
              </div>
              <div class="measure-grid">
                {%- assign measure_fields = 'Bust,Waist,Hips,Height,Dress length' | split: ',' -%}
                {%- for field in measure_fields -%}
                  <label class="measure-field">
                    <span>{{ field }}</span>
                    <input type="number" inputmode="decimal" min="0" step="0.5" data-measure="{{ field }}" placeholder="{% case field %}{% when 'Bust' %}e.g. 36{% when 'Waist' %}e.g. 30{% when 'Hips' %}e.g. 40{% when 'Height' %}e.g. 65{% else %}optional{% endcase %}">
                  </label>
                {%- endfor -%}
              </div>
              <label class="measure-field measure-field--wide">
                <span>Notes for our tailor (optional)</span>
                <input type="text" data-measure="Notes" maxlength="200" placeholder="e.g. I prefer a looser fit around the arms">
              </label>
              <input type="hidden" name="properties[Custom measurements]" id="custom-measurements-value" disabled>
              <p class="custom-size-help">
                Saved with your order for our tailors.
                {% if section.settings.show_size_guide %}<button type="button" class="link-btn" data-size-guide-open>How to measure</button>{% endif %}
              </p>
            </div>
          </div>

          <!-- Quantity + Add to Cart row -->
          <div class="purchase-row">
            <div class="quantity-wrapper">
              <div class="quantity-selector">
                <button type="button" class="qty-btn qty-minus" aria-label="Decrease quantity">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
                <input 
                  type="number" 
                  name="quantity" 
                  value="1" 
                  min="1" 
                  class="qty-input"
                  id="quantity"
                >
                <button type="button" class="qty-btn qty-plus" aria-label="Increase quantity">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>

            <button 
              type="submit" 
              class="btn-add-to-cart"
              id="add-to-cart-btn"
              {% unless product.available %}disabled{% endunless %}
            >
              <span class="btn-text">
                {% if product.available %}
                  <span class="btn-default-text">ADD TO CART • <span class="dynamic-price">{{ product.price | money }}</span></span>
                  <span class="btn-loading-text" style="display: none;">
                    <svg class="loading-spinner" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="37.7" stroke-dashoffset="37.7">
                        <animateTransform attributeName="transform" type="rotate" values="0 8 8;360 8 8" dur="1s" repeatCount="indefinite"/>
                      </circle>
                    </svg>
                    ADDING...
                  </span>
                {% else %}
                  SOLD OUT
                {% endif %}
              </span>
            </button>
          </div>

        </form>

        <!-- Trust / reassurance block -->
        {%- liquid
          assign wa_number = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
          assign wa_message = 'Hi Getglow, I have a question about the ' | append: product.title | append: ': ' | append: shop.url | append: product.url
        -%}
        <ul class="trust-list" aria-label="Order information">
          {%- if section.settings.trust_made_to_order != blank -%}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h4l2 3 2-3h4l3 6-3 1v11H6V10L3 9l3-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              <span>{{ section.settings.trust_made_to_order }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.trust_shipping != blank -%}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><circle cx="7" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.4"/><circle cx="17" cy="17.5" r="1.8" stroke="currentColor" stroke-width="1.4"/></svg>
              <span>{{ section.settings.trust_shipping }}</span>
            </li>
          {%- endif -%}
          {%- if section.settings.trust_secure != blank -%}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M8 10V7a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="1.4"/></svg>
              <span>{{ section.settings.trust_secure }}</span>
            </li>
          {%- endif -%}
          {%- if wa_number != blank -%}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 20l1.3-3.9A8 8 0 1 1 8 19l-4 1Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 9.5c.3 1.7 2.3 3.9 4.5 4.5l1.2-1.2 1.8.8c-.2 1.2-1.1 1.9-2.3 1.8-3-.3-6.5-3.8-6.8-6.8-.1-1.2.6-2.1 1.8-2.3l.8 1.8L9 9.5Z" fill="currentColor"/></svg>
              <span>{{ section.settings.trust_whatsapp_text }} <a href="https://wa.me/{{ wa_number }}?text={{ wa_message | url_encode }}" target="_blank" rel="noopener">Chat on WhatsApp</a></span>
            </li>
          {%- endif -%}
        </ul>

        <!-- Mobile variants bottom sheet -->
        {% unless product.has_only_default_variant %}
          <div class="variant-sheet-backdrop" id="variant-sheet-backdrop" hidden></div>
          <div class="variant-sheet" id="variant-sheet" role="dialog" aria-modal="true" aria-label="Select options" hidden>
            <div class="variant-sheet-header">
              <div class="variant-sheet-title">Select options</div>
              <button type="button" class="variant-sheet-close" id="variant-sheet-close" aria-label="Close">×</button>
            </div>
            <div class="variant-sheet-body" id="variant-sheet-body"></div>
            <div class="variant-sheet-footer">
              <button type="button" class="variant-sheet-done" id="variant-sheet-done">Done</button>
            </div>
          </div>
        {% endunless %}

        <!-- Product info accordion -->
        {%- liquid
          assign fabric_care = section.settings.default_fabric_care
          if product.metafields.custom.fabric_care != blank
            assign fabric_care = product.metafields.custom.fabric_care | metafield_tag
          endif
          assign fit_info = section.settings.default_fit
          if product.metafields.custom.fit != blank
            assign fit_info = product.metafields.custom.fit | metafield_tag
          endif
        -%}
        <div class="gg-accordion">
          <div class="gg-acc-item">
            <button type="button" class="gg-acc-toggle" aria-expanded="true" aria-controls="acc-details">
              <span>DETAILS</span>
              <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="gg-acc-content" id="acc-details">
              {{ product.description }}
            </div>
          </div>

          {%- if fabric_care != blank -%}
            <div class="gg-acc-item">
              <button type="button" class="gg-acc-toggle" aria-expanded="false" aria-controls="acc-fabric">
                <span>FABRIC &amp; CARE</span>
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="gg-acc-content rte" id="acc-fabric" hidden>{{ fabric_care }}</div>
            </div>
          {%- endif -%}

          {%- if fit_info != blank -%}
            <div class="gg-acc-item">
              <button type="button" class="gg-acc-toggle" aria-expanded="false" aria-controls="acc-fit">
                <span>FIT &amp; SIZING</span>
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="gg-acc-content rte" id="acc-fit" hidden>
                {{ fit_info }}
                {% if section.settings.show_size_guide %}<p><button type="button" class="link-btn" data-size-guide-open>View size guide</button></p>{% endif %}
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.delivery_returns != blank -%}
            <div class="gg-acc-item">
              <button type="button" class="gg-acc-toggle" aria-expanded="false" aria-controls="acc-delivery">
                <span>DELIVERY &amp; FINAL SALE</span>
                <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="gg-acc-content rte" id="acc-delivery" hidden>{{ section.settings.delivery_returns }}</div>
            </div>
          {%- endif -%}
        </div>

        <!-- Share Button -->
        <div class="product-share">
          <button type="button" class="share-btn" onclick="shareProduct()">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M12 5.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM4 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM5.5 8.5L10.5 11M10.5 5L5.5 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            SHARE
          </button>
        </div>

      </div>
    </div>
  </div>
</div>
<!-- Lightbox Modal - outside all product containers -->
<div id="lightbox" style="display:none;" onclick="closeLightbox(event)">
  <button class="lightbox-close" onclick="closeLightbox()">&#x2715;</button>
  <button class="lightbox-prev" onclick="lightboxPrev(event)">&#8249;</button>
  <button class="lightbox-next" onclick="lightboxNext(event)">&#8250;</button>
  <div class="lightbox-inner">
    <img id="lightbox-img" src="" alt="">
  </div>
</div>

<!-- Size guide modal -->
{%- if section.settings.show_size_guide -%}
<div class="size-guide-modal" id="size-guide-modal" role="dialog" aria-modal="true" aria-labelledby="size-guide-title" hidden>
  <div class="size-guide-backdrop" data-size-guide-close></div>
  <div class="size-guide-panel">
    <div class="size-guide-header">
      <h2 id="size-guide-title">Size guide</h2>
      <button type="button" class="size-guide-close" data-size-guide-close aria-label="Close size guide">&times;</button>
    </div>
    <div class="size-guide-body">
      {%- if section.settings.size_guide_page != blank -%}
        <div class="rte">{{ section.settings.size_guide_page.content }}</div>
      {%- else -%}
        <p class="size-guide-intro">Body measurements in inches (UK sizing). Not sure, or between sizes? Add your measurements on the product page and our tailors will make it to fit you.</p>
        <div class="size-table-wrap">
          <table class="size-table">
            <thead><tr><th scope="col">UK size</th><th scope="col">Bust</th><th scope="col">Waist</th><th scope="col">Hips</th></tr></thead>
            <tbody>
              <tr><th scope="row">6</th><td>31</td><td>24</td><td>34</td></tr>
              <tr><th scope="row">8</th><td>32</td><td>25</td><td>35</td></tr>
              <tr><th scope="row">10</th><td>34</td><td>27</td><td>37</td></tr>
              <tr><th scope="row">12</th><td>36</td><td>29</td><td>39</td></tr>
              <tr><th scope="row">14</th><td>38</td><td>31</td><td>41</td></tr>
              <tr><th scope="row">16</th><td>40</td><td>33</td><td>43</td></tr>
