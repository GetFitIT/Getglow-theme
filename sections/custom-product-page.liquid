<!-- sections/product-template.liquid -->

<div class="product-page">
  <div class="container">
    <div class="product-grid">
      
      <!-- Left side - Product Images -->
      <div class="product-images">
        <!-- Thumbnail Images -->
        <div class="product-thumbnails">
          {% for image in product.images limit: 10 %}
            <button 
              class="thumbnail-btn {% if forloop.first %}active{% endif %}" 
              data-image-index="{{ forloop.index0 }}"
              data-image-src="{{ image | img_url: '800x800' }}"
            >
              <img src="{{ image | img_url: '100x100' }}" alt="{{ product.title }}" loading="lazy">
            </button>
          {% endfor %}
        </div>

        <!-- Main Product Image (desktop) + Swipe Slider (mobile) -->
        <div class="product-main-image">
          <img 
            id="main-product-image"
            class="desktop-only"
            src="{{ product.featured_image | img_url: '800x800' }}" 
            alt="{{ product.title }}"
            data-zoom="{{ product.featured_image | img_url: '1200x1200' }}"
            onclick="openLightbox()"
          >

          <div class="mobile-image-slider mobile-only" aria-label="Product images">
            <div class="mobile-image-track" id="mobile-image-track">
              {% for image in product.images limit: 10 %}
                <div class="mobile-slide" data-image-index="{{ forloop.index0 }}">
                  <img
                    src="{{ image | img_url: '800x800' }}"
                    alt="{{ product.title }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    draggable="false"
                    data-zoom="{{ image | img_url: '1200x1200' }}"
                  >
                </div>
              {% endfor %}
            </div>

            <div class="mobile-image-dots">
              {% for image in product.images limit: 10 %}
                <button type="button" class="mobile-dot {% if forloop.first %}active{% endif %}" data-image-index="{{ forloop.index0 }}" aria-label="View image {{ forloop.index }}"></button>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>

      <!-- Right side - Product Details -->
      <div class="product-details">
        
        <!-- Product Title -->
        <h1 class="product-title">{{ product.title }}</h1>

        <!-- Product Price -->
        <div class="product-price">
          <span class="price">
            {% if product.compare_at_price > product.price %}
              <span class="sale-price">{{ product.price | money }}</span>
              <span class="original-price">{{ product.compare_at_price | money }}</span>
            {% else %}
              {{ product.price | money }}
            {% endif %}
          </span>
        </div>

        <!-- Add to Cart Success Message -->
        <div class="cart-success-message" id="cart-success-message" style="display: none;">
          <div class="success-content">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="success-icon">
              <path d="M16.667 5l-8.334 8.333-3.333-3.333" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Added to cart!</span>
          </div>
        </div>

        <!-- Product Form -->
        <form action="/cart/add" method="post" enctype="multipart/form-data" id="product-form">
          
       <!-- Mobile variant trigger (only shows on mobile) -->
       {% unless product.has_only_default_variant %}
         <button type="button" class="mobile-variant-trigger" id="mobile-variant-trigger" aria-haspopup="dialog" aria-controls="variant-sheet">
           <span class="mobile-variant-trigger-text" id="mobile-variant-trigger-text">SELECT OPTIONS</span>
         </button>
       {% endunless %}

       <!-- Product Variants -->
{% unless product.has_only_default_variant %}
  <div class="product-variants-wrapper" id="product-variants-wrapper">
    {% for option in product.options_with_values %}
      <div class="product-option">
        <label class="option-label">
          {{ option.name | upcase }}
          <span class="option-selected" data-option="{{ option.name }}">{{ option.selected_value | upcase }}</span>
        </label>
        
        {% if option.name == 'Size' %}
          <div class="size-options">
            {% for value in option.values %}
              <input 
                type="radio" 
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="size-btn">
                {{ value }}
              </label>
            {% endfor %}
          </div>
        {% elsif option.name == 'Color' %}
          <div class="color-options">
            {% for value in option.values %}
              <input 
                type="radio" 
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="color-swatch" 
                data-color="{{ value | handle }}"
                style="background-color: {{ value | downcase | replace: ' ', '' }};"
                title="{{ value }}">
                <span class="sr-only">{{ value }}</span>
                <!-- Fallback pattern for colors that don't work as CSS values -->
                <span class="color-name" style="display: none;">{{ value }}</span>
              </label>
            {% endfor %}
          </div>
        {% elsif option.name == 'Clothing features' %}
          <div class="size-options">
            {% for value in option.values %}
              <input 
                type="radio" 
                id="{{ option.name }}-{{ value | handle }}"
                name="options[{{ option.name }}]"
                value="{{ value }}"
                data-option-position="{{ option.position }}"
                {% if option.selected_value == value %}checked{% endif %}
              >
              <label for="{{ option.name }}-{{ value | handle }}" class="size-btn">
                {{ value }}
              </label>
            {% endfor %}
          </div>
        {% else %}
          <select name="options[{{ option.name }}]" class="product-select" data-option-position="{{ option.position }}">
            {% for value in option.values %}
              <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>
                {{ value }}
              </option>
            {% endfor %}
          </select>
        {% endif %}
      </div>
    {% endfor %}
  </div>
{% endunless %}

          <!-- Hidden variant ID -->
          <select name="id" id="product-variants" style="display: none;">
            {% for variant in product.variants %}
              <option 
                value="{{ variant.id }}"
                {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
                data-price="{{ variant.price }}"
                data-compare-price="{{ variant.compare_at_price }}"
                data-option1="{{ variant.option1 }}"
                data-option2="{{ variant.option2 }}"
                data-option3="{{ variant.option3 }}"
              >
                {{ variant.title }} - {{ variant.price | money }}
              </option>
            {% endfor %}
          </select>

          <!-- Custom size (optional) -->
          <div class="custom-size-wrapper">
            <button type="button" class="custom-size-toggle" id="custom-size-toggle" aria-expanded="false" aria-controls="custom-size-panel">
              Add custom measurements (optional)
            </button>
            <div class="custom-size-panel" id="custom-size-panel" hidden>
              <label for="custom_size" class="custom-size-label">Your measurements</label>
              <input 
                type="text" 
                id="custom_size" 
                name="properties[Custom Size]" 
                placeholder="Example: Bust 34 / Waist 29 / Hip 40"
                class="custom-size-input"
              >
              <div class="custom-size-help">This will be saved with your order for our team to see.</div>
            </div>
          </div>

          <!-- Quantity + Add to Cart row -->
          <div class="purchase-row">
            <div class="quantity-wrapper">
              <div class="quantity-selector">
                <button type="button" class="qty-btn qty-minus" aria-label="Decrease quantity">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
                <input 
                  type="number" 
                  name="quantity" 
                  value="1" 
                  min="1" 
                  class="qty-input"
                  id="quantity"
                >
                <button type="button" class="qty-btn qty-plus" aria-label="Increase quantity">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                    <path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
            </div>

            <button 
              type="submit" 
              class="btn-add-to-cart"
              id="add-to-cart-btn"
              {% unless product.available %}disabled{% endunless %}
            >
              <span class="btn-text">
                {% if product.available %}
                  <span class="btn-default-text">ADD TO CART • <span class="dynamic-price">{{ product.price | money }}</span></span>
                  <span class="btn-loading-text" style="display: none;">
                    <svg class="loading-spinner" width="16" height="16" viewBox="0 0 16 16" fill="none">
                      <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="37.7" stroke-dashoffset="37.7">
                        <animateTransform attributeName="transform" type="rotate" values="0 8 8;360 8 8" dur="1s" repeatCount="indefinite"/>
                      </circle>
                    </svg>
                    ADDING...
                  </span>
                {% else %}
                  SOLD OUT
                {% endif %}
              </span>
            </button>
          </div>

        </form>

        <!-- Mobile variants bottom sheet -->
        {% unless product.has_only_default_variant %}
          <div class="variant-sheet-backdrop" id="variant-sheet-backdrop" hidden></div>
          <div class="variant-sheet" id="variant-sheet" role="dialog" aria-modal="true" aria-label="Select options" hidden>
            <div class="variant-sheet-header">
              <div class="variant-sheet-title">Select options</div>
              <button type="button" class="variant-sheet-close" id="variant-sheet-close" aria-label="Close">×</button>
            </div>
            <div class="variant-sheet-body" id="variant-sheet-body"></div>
            <div class="variant-sheet-footer">
              <button type="button" class="variant-sheet-done" id="variant-sheet-done">Done</button>
            </div>
          </div>
        {% endunless %}

        <!-- Product Description -->
        <div class="product-description">
          <button type="button" class="description-toggle" aria-expanded="true">
            <span>DESCRIPTION</span>
            <svg class="chevron" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="description-content" style="display: block;">
            {{ product.description }}
          </div>
        </div>

        <!-- Share Button -->
        <div class="product-share">
          <button type="button" class="share-btn" onclick="shareProduct()">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M12 5.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM4 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM12 13.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3zM5.5 8.5L10.5 11M10.5 5L5.5 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            SHARE
          </button>
        </div>

      </div>
    </div>
  </div>
</div>
<!-- Lightbox Modal - outside all product containers -->
<div id="lightbox" style="display:none;" onclick="closeLightbox(event)">
  <button class="lightbox-close" onclick="closeLightbox()">&#x2715;</button>
  <button class="lightbox-prev" onclick="lightboxPrev(event)">&#8249;</button>
  <button class="lightbox-next" onclick="lightboxNext(event)">&#8250;</button>
  <div class="lightbox-inner">
    <img id="lightbox-img" src="" alt="">
  </div>
</div>

