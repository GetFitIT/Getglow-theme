<script>
document.addEventListener('DOMContentLoaded', function() {
  // Initialize all functionality once DOM is loaded
  initImageGallery();
  initQuantitySelector();
  initVariantSelection();
  initMobileVariantSheet();
  initCustomSizeToggle();
  initDescriptionToggle();
  initAddToCart();
  
  // Initialize price display
  updatePrice();

  // Add to Cart AJAX functionality
  function initAddToCart() {
    const form = document.getElementById('product-form');
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    const successMessage = document.getElementById('cart-success-message');
    const mobileTrigger = document.getElementById('mobile-variant-trigger');
    const isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
    
    if (form && addToCartBtn) {
      form.addEventListener('submit', function(e) {
        e.preventDefault(); // Prevent default form submission

        // Mobile seamless flow: if variants exist but user hasn't selected, open sheet first
        if (isMobile && mobileTrigger && mobileTrigger.getAttribute('data-has-selection') !== 'true') {
          mobileTrigger.click();
          return;
        }
        
        // Show loading state
        showLoadingState(true);
        
        // Get form data and ensure variant ID is selected
        const formData = new FormData(form);
        const variantId = document.getElementById('product-variants').value;
        const quantity = document.getElementById('quantity').value;
        
        // Debug: Log what we're sending
        console.log('Variant ID:', variantId);
        console.log('Quantity:', quantity);
        console.log('FormData entries:', [...formData.entries()]);
        
        // Ensure we have a valid variant ID
        if (!variantId || variantId === '') {
          alert('Please select a product variant');
          showLoadingState(false);
          return;
        }
        
        // Create the request payload
        const payload = {
          id: variantId,
          quantity: parseInt(quantity)
        };
        
        // Add any additional properties from variant options
        for (let [key, value] of formData.entries()) {
          if (key.startsWith('properties[')) {
            payload[key] = value;
          }
        }
        
        console.log('Sending payload:', payload);
        
        // Add to cart via AJAX
        fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        })
        .then(response => {
          if (!response.ok) {
            throw new Error('Network response was not ok');
          }
          return response.json();
        })
        .then(data => {
          console.log('Product added to cart:', data);
          
          // Show success message
          showSuccessMessage();
          
          // Update cart count and refresh cart drawer/page
          updateCartDisplay();
          
          // Hide loading state
          showLoadingState(false);
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          
          // Show error message
          showErrorMessage();
          
          // Hide loading state
          showLoadingState(false);
        });
      });
    }
  }

  // Show/hide loading state on button
  function showLoadingState(isLoading) {
    const addToCartBtn = document.getElementById('add-to-cart-btn');
    const defaultText = addToCartBtn.querySelector('.btn-default-text');
    const loadingText = addToCartBtn.querySelector('.btn-loading-text');
    
    if (isLoading) {
      addToCartBtn.disabled = true;
      defaultText.style.display = 'none';
      loadingText.style.display = 'flex';
      loadingText.style.alignItems = 'center';
      loadingText.style.gap = '0.5rem';
    } else {
      addToCartBtn.disabled = false;
      defaultText.style.display = 'block';
      loadingText.style.display = 'none';
    }
  }

  // Show success message
  function showSuccessMessage() {
    const successMessage = document.getElementById('cart-success-message');
    if (successMessage) {
      successMessage.style.display = 'block';
      
      // Auto-hide after 3 seconds
      setTimeout(function() {
        successMessage.style.display = 'none';
      }, 3000);
    }
  }

  // Show error message
  function showErrorMessage() {
    alert('Sorry, there was an error adding this item to your cart. Please try again.');
  }

  // Update cart display (count + drawer/page content)
function updateCartDisplay() {
  fetch('/cart.js')
    .then(response => response.json())
    .then(cart => {
      console.log('Updated cart:', cart);
      
      // Update ALL cart count elements throughout the page
      updateAllCartCounts(cart.item_count);
      
      // Update cart drawer content if it exists
      updateCartDrawer(cart);
      
      // Update cart page content if we're on cart page
      if (window.location.pathname === '/cart') {
        updateCartPage(cart);
      }
      
      // Trigger custom events for theme compatibility
      document.dispatchEvent(new CustomEvent('cart:updated', {
        detail: { cart: cart }
      }));
      
      // Trigger other common theme events
      document.dispatchEvent(new CustomEvent('cart:build'));
      document.dispatchEvent(new CustomEvent('ajaxCart:updated', {
        detail: { cart: cart }
      }));
      
      // For themes that use jQuery events
      if (window.jQuery) {
        jQuery(document).trigger('cart.requestComplete', [cart]);
        jQuery(document).trigger('cartUpdated', [cart]);
      }
    })
    .catch(error => {
      console.error('Error fetching cart:', error);
    });
}

// Enhanced function to update ALL cart count elements
function updateAllCartCounts(itemCount) {
  // Main header cart counts
  const cartCount = document.querySelector('.cart-count');
  const cartCountBadge = document.querySelector('[data-cart-count]');
  const cartIconCount = document.querySelector('.cart-icon-count');
  
  if (cartCount) {
    cartCount.textContent = itemCount;
  }
  if (cartCountBadge) {
    cartCountBadge.textContent = itemCount;
    cartCountBadge.setAttribute('data-cart-count', itemCount);
  }
  if (cartIconCount) {
    cartIconCount.textContent = itemCount;
  }
  
  // Cart drawer specific counts (these might be different elements)
  const drawerCartCounts = document.querySelectorAll([
    '.cart-drawer .cart-count',
    '.cart-drawer [data-cart-count]', 
    '.cart-drawer .cart-icon-count',
    '[data-cart-drawer] .cart-count',
    '[data-cart-drawer] [data-cart-count]',
    '#cart-drawer .cart-count',
    '#cart-drawer [data-cart-count]',
    '.drawer__cart .cart-count',
    '.drawer__cart [data-cart-count]',
    // Add more specific selectors based on your theme
    '.cart-drawer__count',
    '.drawer-cart-count',
    '[data-drawer-cart-count]'
  ].join(', '));
  
  drawerCartCounts.forEach(element => {
    if (element) {
      element.textContent = itemCount;
      if (element.hasAttribute('data-cart-count')) {
        element.setAttribute('data-cart-count', itemCount);
      }
    }
  });
}

// Update cart drawer if it exists
function updateCartDrawer(cart) {
  // Common cart drawer selectors
  const cartDrawer = document.querySelector('[data-cart-drawer]') || 
                    document.querySelector('.cart-drawer') ||
                    document.querySelector('#cart-drawer') ||
                    document.querySelector('.drawer__cart');
  
  if (cartDrawer) {
    // Store the current item count before updating
    const currentItemCount = cart.item_count;
    
    // If your theme has a cart drawer, refresh its content
    fetch('/cart?view=drawer')
      .then(response => response.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const newCartContent = doc.querySelector('[data-cart-drawer]') || 
                             doc.querySelector('.cart-drawer') ||
                             doc.querySelector('#cart-drawer') ||
                             doc.querySelector('.drawer__cart');
        
        if (newCartContent) {
          cartDrawer.innerHTML = newCartContent.innerHTML;
          
          // Force update cart counts in the newly loaded drawer content
          setTimeout(() => {
            updateAllCartCounts(currentItemCount);
          }, 100);
        }
      })
      .catch(error => {
        console.error('Error updating cart drawer:', error);
        // Fallback: just update the counts without refreshing content
        updateAllCartCounts(currentItemCount);
      });
  } else {
    // If no drawer found, still update any cart counts that might exist
    updateAllCartCounts(cart.item_count);
  }
}

// Update cart page content if on cart page
function updateCartPage(cart) {
  fetch('/cart')
    .then(response => response.text())
    .then(html => {
      const parser = new DOMParser();
      const doc = parser.parseFromString(html, 'text/html');
      
      // Update cart items
      const cartItems = document.querySelector('[data-cart-items]') ||
                       document.querySelector('.cart-items') ||
                       document.querySelector('#cart-items');
      const newCartItems = doc.querySelector('[data-cart-items]') ||
                         doc.querySelector('.cart-items') ||
                         doc.querySelector('#cart-items');
      
      if (cartItems && newCartItems) {
        cartItems.innerHTML = newCartItems.innerHTML;
      }
      
      // Update cart totals
      const cartTotal = document.querySelector('[data-cart-total]') ||
                       document.querySelector('.cart-total') ||
                       document.querySelector('#cart-total');
      const newCartTotal = doc.querySelector('[data-cart-total]') ||
                         doc.querySelector('.cart-total') ||
                         doc.querySelector('#cart-total');
      
      if (cartTotal && newCartTotal) {
        cartTotal.innerHTML = newCartTotal.innerHTML;
      }
      
      // Update cart counts on the cart page too
      updateAllCartCounts(cart.item_count);
    })
    .catch(error => {
      console.error('Error updating cart page:', error);
      // Fallback: update counts even if page update fails
      updateAllCartCounts(cart.item_count);
    });
}

  // Image gallery functionality with preloading
function initImageGallery() {
  const thumbnails = document.querySelectorAll('.thumbnail-btn');
  const mainImage = document.getElementById('main-product-image');
  const mobileTrack = document.getElementById('mobile-image-track');
  const mobileSlides = mobileTrack ? mobileTrack.querySelectorAll('.mobile-slide') : [];
  const mobileDots = document.querySelectorAll('.mobile-dot');
  const imageCache = new Map(); // Cache for preloaded images

  console.log('Initializing image gallery. Thumbnails found:', thumbnails.length);

  function setActiveIndex(index) {
    thumbnails.forEach(function(btn) { btn.classList.remove('active'); });
    const thumb = document.querySelector('.thumbnail-btn[data-image-index="' + index + '"]');
    if (thumb) thumb.classList.add('active');

    mobileDots.forEach(function(dot) { dot.classList.remove('active'); });
    const dot = document.querySelector('.mobile-dot[data-image-index="' + index + '"]');
    if (dot) dot.classList.add('active');
  }

  function scrollMobileToIndex(index) {
    if (!mobileTrack || !mobileSlides.length) return;
    const slide = mobileSlides[index];
    if (!slide) return;
    mobileTrack.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
  }

  // Preload all images
  function preloadImages() {
    thumbnails.forEach(function(thumbnail) {
      const imageSrc = thumbnail.getAttribute('data-image-src');
      if (imageSrc && !imageCache.has(imageSrc)) {
        const img = new Image();
        img.onload = function() {
          imageCache.set(imageSrc, img);
          console.log('Preloaded:', imageSrc);
        };
        img.src = imageSrc;
      }
    });
  }

  // Initialize preloading
  preloadImages();

  thumbnails.forEach(function(thumbnail, index) {
    thumbnail.addEventListener('click', function(e) {
      e.preventDefault();
      
      console.log('Thumbnail clicked:', index);
      
      // Keep "active" thumbnail + dots in sync
      setActiveIndex(index);
      
      // Get the new image source
      const newImageSrc = this.getAttribute('data-image-src');
      console.log('New image src:', newImageSrc);
      
      // Mobile: scroll the swipe track. Desktop: swap main image src.
      if (mobileTrack && mobileSlides.length) {
        scrollMobileToIndex(index);
      } else if (newImageSrc && mainImage) {
        // Check if image is preloaded
        if (imageCache.has(newImageSrc)) {
          console.log('Using preloaded image');
          mainImage.src = newImageSrc;
        } else {
          // Fallback: load image directly (shouldn't happen if preloading worked)
          console.log('Image not preloaded, loading directly');
          mainImage.src = newImageSrc;
        }
        
        // Also update the zoom data attribute if it exists
        const zoomSrc = newImageSrc.replace('800x800', '1200x1200');
        mainImage.setAttribute('data-zoom', zoomSrc);
        
        console.log('Main image updated successfully');
      }
    });
  });

  // Mobile swipe: update active thumbnail + dots as user scrolls
  if (mobileTrack && mobileSlides.length) {
    let scrollTimeout = null;
    mobileTrack.addEventListener('scroll', function() {
      if (scrollTimeout) window.clearTimeout(scrollTimeout);
      scrollTimeout = window.setTimeout(function() {
        const width = mobileTrack.clientWidth || 1;
        const index = Math.round(mobileTrack.scrollLeft / width);
        setActiveIndex(Math.max(0, Math.min(index, mobileSlides.length - 1)));
      }, 80);
    }, { passive: true });

    // Tap on track opens lightbox (but ignore if it was a swipe)
    let pointerDownX = 0;
    let pointerDownY = 0;
    let wasDragging = false;

    mobileTrack.addEventListener('pointerdown', function(e) {
      pointerDownX = e.clientX;
      pointerDownY = e.clientY;
      wasDragging = false;
    }, { passive: true });

    mobileTrack.addEventListener('pointermove', function(e) {
      if (Math.abs(e.clientX - pointerDownX) > 8 || Math.abs(e.clientY - pointerDownY) > 8) {
        wasDragging = true;
      }
    }, { passive: true });

    mobileTrack.addEventListener('click', function() {
      if (!wasDragging) openLightbox();
    });
  }

  // Dots (visual only) still allow jumping if tapped via JS
  mobileDots.forEach(function(dot) {
    dot.addEventListener('click', function(e) {
      e.preventDefault();
      const index = parseInt(this.getAttribute('data-image-index'), 10);
      if (!isNaN(index)) {
        setActiveIndex(index);
        scrollMobileToIndex(index);
      }
    });
  });
}

// Alternative version with CSS opacity transition for smoother switching
function initImageGalleryWithTransition() {
  const thumbnails = document.querySelectorAll('.thumbnail-btn');
  const mainImage = document.getElementById('main-product-image');
  const imageCache = new Map();

  console.log('Initializing image gallery with transition. Thumbnails found:', thumbnails.length);

  // Add CSS transition if not already present
  if (mainImage) {
    mainImage.style.transition = 'opacity 0.2s ease-in-out';
  }

  // Preload all images
  function preloadImages() {
    thumbnails.forEach(function(thumbnail) {
      const imageSrc = thumbnail.getAttribute('data-image-src');
      if (imageSrc && !imageCache.has(imageSrc)) {
        const img = new Image();
        img.onload = function() {
          imageCache.set(imageSrc, img);
          console.log('Preloaded:', imageSrc);
        };
        img.src = imageSrc;
      }
    });
  }

  // Initialize preloading
  preloadImages();

  thumbnails.forEach(function(thumbnail, index) {
    thumbnail.addEventListener('click', function(e) {
      e.preventDefault();
      
      console.log('Thumbnail clicked:', index);
      
      // Remove active class from all thumbnails
      thumbnails.forEach(function(btn) {
        btn.classList.remove('active');
      });
      
      // Add active class to clicked thumbnail
      this.classList.add('active');
      
      const newImageSrc = this.getAttribute('data-image-src');
      console.log('New image src:', newImageSrc);
      
      if (newImageSrc && mainImage) {
        // Smooth transition: fade out, change src, fade in
        mainImage.style.opacity = '0.7';
        
        setTimeout(function() {
          mainImage.src = newImageSrc;
          
          // Update zoom data attribute
          const zoomSrc = newImageSrc.replace('800x800', '1200x1200');
          mainImage.setAttribute('data-zoom', zoomSrc);
          
          mainImage.style.opacity = '1';
          console.log('Main image updated with transition');
        }, 100); // Small delay for smooth transition
      }
    });
  });
}

  // Quantity selector functionality
  function initQuantitySelector() {
    const qtyInput = document.getElementById('quantity');
    const qtyMinus = document.querySelector('.qty-minus');
    const qtyPlus = document.querySelector('.qty-plus');

    if (qtyMinus && qtyPlus && qtyInput) {
      qtyMinus.addEventListener('click', function() {
        let currentValue = parseInt(qtyInput.value);
        if (currentValue > 1) {
          qtyInput.value = currentValue - 1;
          updatePrice();
        }
      });

      qtyPlus.addEventListener('click', function() {
        let currentValue = parseInt(qtyInput.value);
        qtyInput.value = currentValue + 1;
        updatePrice();
      });

      qtyInput.addEventListener('change', function() {
        if (this.value < 1) this.value = 1;
        updatePrice();
      });
    }
  }

  // Variant selection functionality
  function initVariantSelection() {
    // Handle all variant inputs (radio buttons and selects)
    const variantInputs = document.querySelectorAll('input[name^="options"], select[name^="options"]');
    
    variantInputs.forEach(function(input) {
      const eventType = input.type === 'radio' ? 'change' : 'change';
      input.addEventListener(eventType, function() {
        console.log('Variant option changed:', this.name, '=', this.value);
        
        // Update the selected option display
        updateSelectedOptionDisplay(this);
        
        // Update the variant selection
        updateVariant();
      });
    });
  }

  // Mobile-only: move variants into a bottom sheet + update trigger label
  function initMobileVariantSheet() {
    const isMobile = window.matchMedia && window.matchMedia('(max-width: 768px)').matches;
    if (!isMobile) return;

    const wrapper = document.getElementById('product-variants-wrapper');
    const trigger = document.getElementById('mobile-variant-trigger');
    const triggerText = document.getElementById('mobile-variant-trigger-text');
    const sheet = document.getElementById('variant-sheet');
    const sheetBody = document.getElementById('variant-sheet-body');
    const backdrop = document.getElementById('variant-sheet-backdrop');
    const closeBtn = document.getElementById('variant-sheet-close');
    const doneBtn = document.getElementById('variant-sheet-done');

    if (!wrapper || !trigger || !triggerText || !sheet || !sheetBody || !backdrop) return;

    // Move the existing variants UI into the sheet so existing JS continues to work
    sheetBody.appendChild(wrapper);
    wrapper.style.display = 'block';

    function openSheet() {
      backdrop.hidden = false;
      sheet.hidden = false;
      document.body.style.overflow = 'hidden';
      trigger.setAttribute('aria-expanded', 'true');
    }

    function closeSheet() {
      backdrop.hidden = true;
      sheet.hidden = true;
      document.body.style.overflow = '';
      trigger.setAttribute('aria-expanded', 'false');
    }

    function updateMobileVariantTriggerLabel() {
      const size = document.querySelector('.option-selected[data-option="Size"]');
      const color = document.querySelector('.option-selected[data-option="Color"]');
      const hasSelection = trigger.getAttribute('data-has-selection') === 'true';

      const sizeVal = size ? (size.textContent || '').trim() : '';
      const colorVal = color ? (color.textContent || '').trim() : '';

      // Default prompt text before user selects anything
      if (!hasSelection) {
        triggerText.textContent = size ? 'SELECT SIZE' : 'SELECT OPTIONS';
        return;
      }

      // After selection: show color + size when both exist (e.g. "RED • UK22")
      if (colorVal && sizeVal) {
        triggerText.textContent = (colorVal + ' • ' + sizeVal).toUpperCase();
        return;
      }

      // Otherwise show whichever exists
      if (sizeVal) {
        triggerText.textContent = ('SIZE • ' + sizeVal).toUpperCase();
        return;
      }

      if (colorVal) {
        triggerText.textContent = ('COLOR • ' + colorVal).toUpperCase();
        return;
      }

      triggerText.textContent = 'SELECT OPTIONS';
    }

    // Expose helper to other functions in this closure
    window.__updateMobileVariantTriggerLabel = updateMobileVariantTriggerLabel;
    window.__closeMobileVariantSheet = closeSheet;
    window.__isMobileVariantSheetOpen = () => !sheet.hidden;

    updateMobileVariantTriggerLabel();

    trigger.addEventListener('click', openSheet);
    backdrop.addEventListener('click', closeSheet);
    if (closeBtn) closeBtn.addEventListener('click', closeSheet);
    if (doneBtn) doneBtn.addEventListener('click', closeSheet);
  }

  function initCustomSizeToggle() {
    const toggle = document.getElementById('custom-size-toggle');
    const panel = document.getElementById('custom-size-panel');
    if (!toggle || !panel) return;

    toggle.addEventListener('click', function() {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      panel.hidden = isExpanded;
    });
  }

  // Update the selected option display text
  function updateSelectedOptionDisplay(changedInput) {
    const optionContainer = changedInput.closest('.product-option');
    if (optionContainer) {
      const selectedSpan = optionContainer.querySelector('.option-selected');
      if (selectedSpan) {
        selectedSpan.textContent = changedInput.value.toUpperCase();
      }
    }

    // Keep the mobile trigger text in sync (if mobile sheet is enabled)
    if (window.__updateMobileVariantTriggerLabel) {
      const mobileTrigger = document.getElementById('mobile-variant-trigger');
      if (mobileTrigger) mobileTrigger.setAttribute('data-has-selection', 'true');
      window.__updateMobileVariantTriggerLabel();
    }

    // Mobile sheet should only close via Done / Close controls (not on selection)
  }

  // Description toggle functionality
  function initDescriptionToggle() {
    const descriptionToggle = document.querySelector('.description-toggle');
    const descriptionContent = document.querySelector('.description-content');

    if (descriptionToggle && descriptionContent) {
      descriptionToggle.addEventListener('click', function() {
        const isExpanded = this.getAttribute('aria-expanded') === 'true';
        this.setAttribute('aria-expanded', !isExpanded);
        descriptionContent.style.display = isExpanded ? 'none' : 'block';
      });
    }
  }

  // Update variant based on selected options
  function updateVariant() {
    const variantSelect = document.getElementById('product-variants');
    if (!variantSelect) return;

    // Get all selected options
    const selectedOptions = [];
    
    // Get values from radio buttons and selects
    const radioInputs = document.querySelectorAll('input[name^="options"]:checked');
    const selectInputs = document.querySelectorAll('select[name^="options"]');
    
    radioInputs.forEach(function(input) {
      selectedOptions.push(input.value);
    });
    
    selectInputs.forEach(function(select) {
      selectedOptions.push(select.value);
    });

    console.log('Selected options:', selectedOptions);

    // Find matching variant
    const variants = Array.from(variantSelect.options);
    let matchingVariant = null;

    // Try to find exact match
    for (let i = 0; i < variants.length; i++) {
      const option = variants[i];
      const variantOptions = [
        option.getAttribute('data-option1'),
        option.getAttribute('data-option2'),
        option.getAttribute('data-option3')
      ].filter(Boolean); // Remove null/undefined values

      console.log('Checking variant:', variantOptions, 'against selected:', selectedOptions);

      // Check if all selected options match this variant
      const isMatch = selectedOptions.length === variantOptions.length && 
                     selectedOptions.every(selected => variantOptions.includes(selected));

      if (isMatch) {
        matchingVariant = option;
        console.log('Found matching variant:', option.text);
        break;
      }
    }

    if (matchingVariant) {
      variantSelect.value = matchingVariant.value;
      
      // Update button availability
      const addToCartBtn = document.querySelector('.btn-add-to-cart');
      const btnDefaultText = addToCartBtn.querySelector('.btn-default-text');
      const isAvailable = !matchingVariant.disabled;
      
      if (addToCartBtn) {
        addToCartBtn.disabled = !isAvailable;
        if (btnDefaultText) {
          btnDefaultText.innerHTML = isAvailable ? 
            'ADD TO CART • <span class="dynamic-price">' + matchingVariant.text.split(' - ')[1] + '</span>' :
            'SOLD OUT';
        }
      }
      
      updatePrice();
    } else {
      console.log('No matching variant found');
    }
  }

  // Update price display
function updatePrice() {
  const variantSelect = document.getElementById('product-variants');
  const qtyInput = document.getElementById('quantity');
  const dynamicPrice = document.querySelector('.dynamic-price');

  if (variantSelect && qtyInput && dynamicPrice) {
    const selectedVariant = variantSelect.options[variantSelect.selectedIndex];
    if (selectedVariant) {
      const price = parseFloat(selectedVariant.getAttribute('data-price'));
      const quantity = parseInt(qtyInput.value) || 1;
      const totalPrice = (price * quantity) / 100; // Convert from cents

      // Get the currency symbol from Shopify Liquid
      const currencySymbol = '{{ shop.currency_symbol }}';

      // Format price with the correct symbol
      dynamicPrice.textContent = currencySymbol + totalPrice.toFixed(2);

      console.log('Price updated:', dynamicPrice.textContent);
    }
  }
}

});

