<!-- sections/maximalist-dream-banner.liquid -->

<div class="maximalist-banner-wrapper">
  <div class="maximalist-banner-container">
    {% if section.settings.heading != blank %}
      <h2 class="maximalist-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.description != blank %}
      <div class="maximalist-description">
        {{ section.settings.description }}
      </div>
    {% endif %}
  </div>
</div>

<style>
  .maximalist-banner-wrapper {
    background-color: {{ section.settings.background_color }};
    padding: {{ section.settings.section_padding_top }}px 0 {{ section.settings.section_padding_bottom }}px 0;
    text-align: center;
  }

  .maximalist-banner-container {
    max-width: {{ section.settings.content_width }}px;
    margin: 0 auto;
    padding: 0 0px;
  }

  .maximalist-heading {
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    color: {{ section.settings.heading_color }};
    margin: 0 0 {{ section.settings.spacing_between }}px 0;
    letter-spacing: {{ section.settings.heading_letter_spacing | divided_by: 100.0 }}em;
    line-height: {{ section.settings.heading_line_height | divided_by: 10.0 }};
    text-transform: {{ section.settings.heading_text_transform }};
    font-family: {{ section.settings.heading_font }}, sans-serif;
  }

  .maximalist-description {
    font-size: {{ section.settings.description_size }}px;
    font-weight: {{ section.settings.description_weight }};
    color: {{ section.settings.description_color }};
    line-height: {{ section.settings.description_line_height | divided_by: 10.0 }};
    margin: 0;
    font-family: {{ section.settings.description_font }}, sans-serif;
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .maximalist-heading {
      font-size: {{ section.settings.heading_size | times: 0.8 }}px;
    }
    
    .maximalist-description {
      font-size: {{ section.settings.description_size | times: 0.9 }}px;
    }
    
    .maximalist-banner-container {
      padding: 0 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Maximalist Banner",
  "tag": "section",
  "class": "maximalist-banner-section",
  "settings": [
    {
      "type": "header",
      "content": "Content Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A MAXIMALIST'S DREAM"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Getglow is a contemporary women's wear brand that empowers women through meticulously crafted demi-couture pieces. We seamlessly blend African heritage with modern design, celebrating femininity and individuality while transcending cultural boundaries. Our aim is to usher in a new era of inclusive and accessible luxury, with a focus on embroidery and embellishment. Additionally, we are proud to offer a diverse size range from XXS to XXXXL.</p>"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Content Width (px)",
      "min": 800,
      "max": 1400,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "Top Padding (px)",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "Bottom Padding (px)",
      "min": 20,
      "max": 200,
      "step": 10,
      "default": 80
    },
    {
      "type": "range",
      "id": "spacing_between",
      "label": "Spacing Between Heading & Description (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Font Size (px)",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra Bold" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#333333"
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Heading Letter Spacing (em)",
      "min": 0,
      "max": 50,
      "step": 5,
      "default": 10
    },
    {
      "type": "range",
      "id": "heading_line_height",
      "label": "Heading Line Height",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "select",
      "id": "heading_text_transform",
      "label": "Heading Text Transform",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "capitalize", "label": "Capitalize" }
      ],
      "default": "uppercase"
    },
    {
      "type": "text",
      "id": "heading_font",
      "label": "Heading Font Family",
      "default": "Arial",
      "info": "Enter a font name (e.g., 'Helvetica', 'Georgia', 'Times New Roman')"
    },
    {
      "type": "header",
      "content": "Description Settings"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description Font Size (px)",
      "min": 12,
      "max": 32,
      "step": 1,
      "default": 16
    },
    {
      "type": "select",
      "id": "description_weight",
      "label": "Description Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" }
      ],
      "default": "400"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Description Line Height",
      "min": 12,
      "max": 25,
      "step": 1,
      "default": 16
    },
    {
      "type": "text",
      "id": "description_font",
      "label": "Description Font Family",
      "default": "Arial",
      "info": "Enter a font name (e.g., 'Helvetica', 'Georgia', 'Times New Roman')"
    },
    {
      "type": "header",
      "content": "Background Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f8f8"
    }
  ],
  "presets": [
    {
      "name": "Maximalist Banner"
    }
  ]
}
{% endschema %}