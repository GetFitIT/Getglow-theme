          "max": 80,
          "step": 2,
          "default": 48,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Icon Color",
          "default": "#999999"
        },
        {
          "type": "header",
          "content": "Content Settings"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "WORLDWIDE SHIPPING"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title Font Size",
          "min": 12,
          "max": 32,
          "step": 1,
          "default": 16,
          "unit": "px"
        },
        {
          "type": "select",
          "id": "title_weight",
          "label": "Title Font Weight",
          "options": [
            {
              "value": "300",
              "label": "Light"
            },
            {
              "value": "400",
              "label": "Normal"
            },
            {
              "value": "500",
              "label": "Medium"
            },
            {
              "value": "600",
              "label": "Semi Bold"
            },
            {
              "value": "700",
              "label": "Bold"
            }
          ],
          "default": "600"
        },
        {
          "type": "select",
          "id": "title_transform",
          "label": "Title Text Transform",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "uppercase",
              "label": "Uppercase"
            },
            {
              "value": "lowercase",
              "label": "Lowercase"
            },
            {
              "value": "capitalize",
              "label": "Capitalize"
            }
          ],
          "default": "uppercase"
        },
        {
          "type": "range",
          "id": "title_spacing",
          "label": "Title Letter Spacing",
          "min": 0,
          "max": 3,
          "step": 0.1,
          "default": 1,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color",
          "default": "#333333"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "SHIP ANYWHERE, RATES AVAILABLE AT CHECKOUT."
        },
        {
          "type": "range",
          "id": "subtitle_size",
          "label": "Subtitle Font Size",
          "min": 10,
          "max": 20,
          "step": 1,
          "default": 12,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "subtitle_color",
          "label": "Subtitle Color",
          "default": "#999999"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "info": "Optional additional text"
        },
        {
          "type": "range",
          "id": "description_size",
          "label": "Description Font Size",
          "min": 10,
          "max": 16,
          "step": 1,
          "default": 11,
          "unit": "px"
        },
        {
          "type": "color",
          "id": "description_color",
          "label": "Description Color",
          "default": "#999999"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Info Banner",
      "blocks": [
        {
          "type": "info_item",
          "settings": {
            "title": "WORLDWIDE SHIPPING",
            "subtitle": "SHIP ANYWHERE, RATES AVAILABLE AT CHECKOUT.",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M8 17l4 4 4-4m-4-5v9\"/><path d=\"M3 4h13l3 6-13 0z\"/></svg>"
          }
        },
        {
          "type": "info_item",
          "settings": {
            "title": "24/7 SUPPORT",
            "subtitle": "EMAIL US AT INFO@GETGLOW.NG",
            "description": "WHATSAPP +254817108658",
            "custom_svg": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"><path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\"/></svg>"
          }
        }
      ]
    }
  ]
}
{% endschema %}