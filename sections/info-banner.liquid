<!-- sections/info-banner.liquid -->
<section class="info-banner" style="
  background-color: {{ section.settings.background_color }};
  padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px 0;
">
  <div class="info-banner__container" style="
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  ">
    <div class="info-banner__grid" style="
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
      flex-wrap: wrap;
    ">
      
      {% for block in section.blocks %}
        <div class="info-banner__item" style="
          flex: 1;
          text-align: center;
          min-width: 250px;
        " {{ block.shopify_attributes }}>
          
          {% if block.settings.icon_type == 'svg' and block.settings.custom_svg != blank %}
            <div class="info-banner__icon" style="
              margin-bottom: 16px;
              display: flex;
              justify-content: center;
            ">
              <div style="
                width: {{ block.settings.icon_size }}px;
                height: {{ block.settings.icon_size }}px;
                color: {{ block.settings.icon_color }};
              ">
                {{ block.settings.custom_svg }}
              </div>
            </div>
          {% elsif block.settings.icon_type == 'image' and block.settings.icon_image != blank %}
            <div class="info-banner__icon" style="margin-bottom: 16px;">
              <img 
                src="{{ block.settings.icon_image | img_url: 'master' }}" 
                alt="{{ block.settings.title }}"
                style="
                  width: {{ block.settings.icon_size }}px;
                  height: {{ block.settings.icon_size }}px;
                  margin: 0 auto;
                  display: block;
                "
              >
            </div>
          {% endif %}
          
          {% if block.settings.title != blank %}
            <h3 class="info-banner__title" style="
              font-size: {{ block.settings.title_size }}px;
              font-weight: {{ block.settings.title_weight }};
              color: {{ block.settings.title_color }};
              margin: 0 0 8px 0;
              text-transform: {{ block.settings.title_transform }};
              letter-spacing: {{ block.settings.title_spacing }}px;
            ">
              {{ block.settings.title }}
            </h3>
          {% endif %}
          
          {% if block.settings.subtitle != blank %}
            <p class="info-banner__subtitle" style="
              font-size: {{ block.settings.subtitle_size }}px;
              color: {{ block.settings.subtitle_color }};
              margin: 0 0 4px 0;
              line-height: 1.4;
            ">
              {{ block.settings.subtitle }}
            </p>
          {% endif %}
          
          {% if block.settings.description != blank %}
            <p class="info-banner__description" style="
              font-size: {{ block.settings.description_size }}px;
              color: {{ block.settings.description_color }};
              margin: 0;
              line-height: 1.4;
            ">
              {{ block.settings.description }}
            </p>
          {% endif %}
          
        </div>
      {% endfor %}
      
    </div>
  </div>
</section>

<style>
  .info-banner__grid {
    {% if section.settings.mobile_stack %}
      @media (max-width: 768px) {
        flex-direction: column;
        text-align: center;
      }
    {% endif %}
  }
  
  .info-banner__item {
    {% if section.settings.mobile_stack %}
      @media (max-width: 768px) {
        min-width: 100%;
        margin-bottom: 30px;
      }
      
      @media (max-width: 768px) {
        .info-banner__item:last-child {
          margin-bottom: 0;
        }
      }
    {% endif %}
  }
</style>

{% schema %}
{
  "name": "Info Banner",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f8f8"
