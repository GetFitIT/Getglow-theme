{{ 'banner-section.css' | asset_url | stylesheet_tag }}

<section class="banner-section" 
         style="background-image: url('{{ section.settings.background_image | img_url: '1200x600' }}');">
  <div class="banner-overlay"></div>
  <div class="banner-content">
    {% if section.settings.heading != blank %}
      <h2 class="banner-heading">{{ section.settings.heading }}</h2>
    {% endif %}
    
    {% if section.settings.subheading != blank %}
      <p class="banner-subheading">{{ section.settings.subheading }}</p>
    {% endif %}
    
    {% if section.settings.button_text != blank %}
      <a href="{{ section.settings.button_link | default: '#' }}" 
         class="banner-button glass-button">
        {{ section.settings.button_text }}
      </a>
    {% endif %}
  </div>
</section>

<style>
.banner-section {
  position: relative;
  height: {{ section.settings.section_height }}px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  margin: {{ section.settings.margin_top }}px 0 {{ section.settings.margin_bottom }}px 0;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, {{ section.settings.overlay_opacity | divided_by: 100.0 }});
  z-index: 1;
}

.banner-content {
  position: relative;
  z-index: 2;
  text-align: center;
  color: {{ section.settings.text_color }};
  max-width: 600px;
  padding: 0 20px;
}

.banner-heading {
  font-size: {{ section.settings.heading_size }}px;
  font-weight: {{ section.settings.heading_weight }};
  margin: 0 0 12px 0;
  letter-spacing: 2px;
  text-transform: uppercase;
  line-height: 1.2;
}

.banner-subheading {
  font-size: {{ section.settings.subheading_size }}px;
  font-weight: {{ section.settings.subheading_weight }};
  margin: 0 0 24px 0;
  opacity: 0.9;
  line-height: 1.4;
}

.glass-button {
  display: inline-block;
  padding: 10px 28px;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 25px;
  color: {{ section.settings.button_text_color }};
  text-decoration: none;
  font-size: {{ section.settings.button_text_size }}px;
  font-weight: 500;
  letter-spacing: 1px;
  text-transform: uppercase;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.glass-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, 
    transparent, 
    rgba(255, 255, 255, 0.2), 
    transparent
  );
  transition: left 0.5s ease;
}

.glass-button:hover {
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.4);
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25);
}

.glass-button:hover::before {
  left: 100%;
}

.glass-button:active {
  transform: translateY(0);
}

/* Responsive */
@media (max-width: 768px) {
  .banner-section {
    height: {{ section.settings.mobile_height }}px;
  }
  
  .banner-heading {
    font-size: {{ section.settings.heading_size | divided_by: 1.3 }}px;
  }
  
  .banner-subheading {
    font-size: {{ section.settings.subheading_size | divided_by: 1.2 }}px;
  }
  
  .glass-button {
    font-size: {{ section.settings.button_text_size | divided_by: 1.1 }}px;
    padding: 8px 20px;
  }
}
</style>

{% schema %}
{
  "name": "Banner Section",
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image",
      "info": "Recommended size: 1200x600px"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_height",
      "min": 200,
      "max": 500,
      "step": 25,
      "unit": "px",
      "label": "Banner Height (Desktop)",
      "default": 350
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 150,
      "max": 400,
      "step": 25,
      "unit": "px",
      "label": "Banner Height (Mobile)",
      "default": 250
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Top",
      "default": 20
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Margin Bottom",
      "default": 20
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "WANNI FUGA"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading Font Size",
      "default": 36
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi Bold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Subheading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our latest collection"
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading Font Size",
      "default": 16
    },
    {
      "type": "select",
      "id": "subheading_weight",
      "label": "Subheading Font Weight",
      "options": [
        { "value": "300", "label": "Light" },
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" }
      ],
      "default": "400"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "VIEW ALL"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "range",
      "id": "button_text_size",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Button Font Size",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Banner Section",
      "settings": {
        "heading": "WANNI FUGA",
        "subheading": "Discover our latest collection",
        "button_text": "VIEW ALL"
      }
    }
  ]
}
{% endschema %}