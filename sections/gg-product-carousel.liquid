<section class="gg-pc" id="gg-pc-{{ section.id }}">
  <div class="gg-wrap">
    <div class="gg-pc__head">
      <div>
        {%- if section.settings.heading != blank -%}<h2 class="gg-section-title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<p class="gg-section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
      </div>
      <div class="gg-pc__nav" aria-hidden="true">
        <button type="button" class="gg-pc__arrow" data-dir="-1" tabindex="-1" aria-label="Previous">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button type="button" class="gg-pc__arrow" data-dir="1" tabindex="-1" aria-label="Next">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

    <ul class="gg-pc__track" role="list">
      {%- for p in section.settings.products -%}
        {%- liquid
          assign color_option = nil
          for o in p.options_with_values
            assign oname = o.name | downcase
            if oname == 'color' or oname == 'colour'
              assign color_option = o
            endif
          endfor
          assign img2 = p.images[1]
        -%}
        <li class="gg-card">
          <a href="{{ p.url }}" class="gg-card__link">
            <span class="gg-card__media">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 720 | image_tag:
                  widths: '360, 540, 720',
                  sizes: '(max-width: 768px) 72vw, 25vw',
                  loading: 'lazy',
                  alt: p.featured_image.alt | default: p.title,
                  class: 'gg-card__img gg-card__img--main' }}
              {%- endif -%}
              {%- if img2 -%}
                {{ img2 | image_url: width: 720 | image_tag:
                  widths: '360, 540, 720',
                  sizes: '25vw',
                  loading: 'lazy',
                  alt: '',
                  class: 'gg-card__img gg-card__img--hover' }}
              {%- endif -%}
              {%- if section.settings.badge != blank -%}<span class="gg-card__badge">{{ section.settings.badge }}</span>{%- endif -%}
              {% render 'gg-card-price', product: p, mode: 'badge' %}
            </span>
            <span class="gg-card__body">
              <span class="gg-card__title">{{ p.title }}</span>
              <span class="gg-card__price">{% render 'gg-card-price', product: p %}</span>
              {%- if color_option and color_option.values.size > 1 -%}
                <span class="gg-card__swatches" aria-label="{{ color_option.values.size }} colours">
                  {%- for v in color_option.values limit: 5 -%}
                    <span class="gg-card__dot" style="background: {% render 'gg-swatch-bg', color: v %};" title="{{ v | escape }}"></span>
                  {%- endfor -%}
                  {%- if color_option.values.size > 5 -%}
                    <span class="gg-card__more">+{{ color_option.values.size | minus: 5 }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if section.settings.button_label != blank -%}
      <div class="gg-pc__cta">
        <a class="gg-btn gg-btn--secondary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'gg-shared-styles' %}
<style>
  #gg-pc-{{ section.id }} { padding: 72px 0; }
  #gg-pc-{{ section.id }} .gg-pc__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  #gg-pc-{{ section.id }} .gg-pc__head .gg-section-sub { margin-left: 0; }
  #gg-pc-{{ section.id }} .gg-pc__nav { display: flex; gap: 8px; }
  #gg-pc-{{ section.id }} .gg-pc__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid #d9cfbd;
    border-radius: 50%;
    background: #fff;
    color: #1d1a16;
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s, opacity 0.2s;
  }
  #gg-pc-{{ section.id }} .gg-pc__arrow:hover { background: #1d1a16; color: #fff; }
  #gg-pc-{{ section.id }} .gg-pc__arrow:disabled { opacity: 0.35; cursor: default; background: #fff; color: #1d1a16; }

  #gg-pc-{{ section.id }} .gg-pc__track {
    list-style: none;
    margin: 0;
    padding: 0 0 4px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 3 * 20px) / 4);
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
  }
  #gg-pc-{{ section.id }} .gg-pc__track::-webkit-scrollbar { display: none; }

  #gg-pc-{{ section.id }} .gg-card { scroll-snap-align: start; }
  #gg-pc-{{ section.id }} .gg-card__link { display: block; text-decoration: none; color: #1d1a16; }
  #gg-pc-{{ section.id }} .gg-card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 10px;
    overflow: hidden;
    background: #f1ebe0;
  }
  #gg-pc-{{ section.id }} .gg-card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: opacity 0.45s ease, transform 0.6s ease;
  }
  #gg-pc-{{ section.id }} .gg-card__img--hover { opacity: 0; }
  @media (hover: hover) {
    #gg-pc-{{ section.id }} .gg-card__link:hover .gg-card__img--hover { opacity: 1; }
    #gg-pc-{{ section.id }} .gg-card__link:hover .gg-card__img { transform: scale(1.03); }
  }
  #gg-pc-{{ section.id }} .gg-card__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #1d1a16;
  }
  #gg-pc-{{ section.id }} .gg-card__body { display: flex; flex-direction: column; gap: 4px; padding: 14px 2px 0; }
  #gg-pc-{{ section.id }} .gg-card__title {
    font-size: 16px;
    font-weight: 500;
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #gg-pc-{{ section.id }} .gg-card__price { font-size: 15px; font-weight: 600; color: #6b5b3e; }
  #gg-pc-{{ section.id }} .gg-card__swatches { display: flex; align-items: center; gap: 6px; margin-top: 6px; }
  #gg-pc-{{ section.id }} .gg-card__dot {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  #gg-pc-{{ section.id }} .gg-card__more { font-size: 13px; color: #6b6b6b; }
  #gg-pc-{{ section.id }} .gg-pc__cta { text-align: center; margin-top: 36px; }

  @media (max-width: 989px) {
    #gg-pc-{{ section.id }} .gg-pc__track { grid-auto-columns: calc((100% - 2 * 16px) / 3); gap: 16px; }
  }

  @media (max-width: 768px) {
    #gg-pc-{{ section.id }} { padding: 48px 0; }
    #gg-pc-{{ section.id }} .gg-pc__head { justify-content: center; text-align: center; margin-bottom: 20px; }
    #gg-pc-{{ section.id }} .gg-pc__head .gg-section-sub { margin-left: auto; }
    #gg-pc-{{ section.id }} .gg-pc__nav { display: none; }
    #gg-pc-{{ section.id }} .gg-pc__track {
      grid-auto-columns: 72%;
      gap: 12px;
      margin: 0 -20px;
      padding: 0 20px 4px;
      scroll-padding: 0 20px;
    }
    #gg-pc-{{ section.id }} .gg-card__title { font-size: 15px; }
    #gg-pc-{{ section.id }} .gg-pc__cta .gg-btn { width: 100%; }
  }
</style>

<script>
  (function() {
    var root = document.getElementById('gg-pc-{{ section.id }}');
    if (!root) return;
    var track = root.querySelector('.gg-pc__track');
    var arrows = root.querySelectorAll('.gg-pc__arrow');
    if (!track || !arrows.length) return;
    function update() {
      var max = track.scrollWidth - track.clientWidth - 2;
      arrows[0].disabled = track.scrollLeft <= 2;
      arrows[1].disabled = track.scrollLeft >= max;
    }
    arrows.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var dir = parseInt(btn.getAttribute('data-dir'), 10);
        track.scrollBy({ left: dir * track.clientWidth * 0.9, behavior: 'smooth' });
      });
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Getglow product carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bestsellers" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Our most-loved pieces, made to order for you." },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "text", "id": "badge", "label": "Badge on images (optional)", "info": "e.g. Bestseller" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Getglow product carousel" }]
}
{% endschema %}
