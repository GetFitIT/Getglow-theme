{%- liquid
  assign rec = section.settings.recommend_collection
  if rec == blank
    assign rec = collections['dresses']
  endif
  assign wa = 'Hi Getglow, I have a question about my order.' | url_encode
-%}
{% render 'gg-shared-styles' %}
{% render 'gg-product-card-styles' %}

<section class="gg-cart" id="gg-cart-{{ section.id }}">
  <div class="gg-wrap">
    <header class="gg-cart__head">
      <h1 class="gg-cart__title">Your bag{% if cart.item_count > 0 %} <span>({{ cart.item_count }})</span>{% endif %}</h1>
      {%- if cart.item_count > 0 -%}
        <a class="gg-cart__continue" href="{{ routes.all_products_collection_url }}">← Continue shopping</a>
      {%- endif -%}
    </header>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" id="gg-cart-form" class="gg-cart__layout" novalidate>
        <div class="gg-cart__items">
          <ul class="gg-cart__list" role="list">
            {%- for item in cart.items -%}
              <li class="gg-line">
                <a href="{{ item.url }}" class="gg-line__img">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 360 | image_tag: widths: '180, 270, 360', sizes: '140px', loading: 'lazy', alt: item.product.title }}
                  {%- endif -%}
                </a>
                <div class="gg-line__info">
                  <div class="gg-line__top">
                    <a href="{{ item.url }}" class="gg-line__name">{{ item.product.title }}</a>
                    <span class="gg-line__price">{{ item.final_line_price | money }}</span>
                  </div>
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="gg-line__variant">
                      {%- for o in item.options_with_values -%}
                        <span>{{ o.name }}: <strong>{{ o.value }}</strong></span>
                      {%- endfor -%}
                    </p>
                  {%- endunless -%}
                  {%- assign shown_props = 0 -%}
                  {%- for p in item.properties -%}
                    {%- assign first_char = p.first | slice: 0 -%}
                    {%- if p.last != blank and first_char != '_' -%}
                      {%- assign shown_props = shown_props | plus: 1 -%}
                      <p class="gg-line__prop"><span>{{ p.first }}</span>{{ p.last }}</p>
                    {%- endif -%}
                  {%- endfor -%}
                  {%- if item.quantity > 1 -%}<p class="gg-line__unit">{{ item.final_price | money }} each</p>{%- endif -%}
                  <div class="gg-line__actions">
                    <div class="gg-qty" data-line="{{ forloop.index }}">
                      <button type="button" class="gg-qty__btn" data-step="-1" aria-label="Decrease quantity of {{ item.product.title | escape }}">−</button>
                      <input class="gg-qty__input" type="number" name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric" aria-label="Quantity of {{ item.product.title | escape }}">
                      <button type="button" class="gg-qty__btn" data-step="1" aria-label="Increase quantity of {{ item.product.title | escape }}">+</button>
                    </div>
                    <a href="{{ item.url_to_remove }}" class="gg-line__remove">Remove</a>
                  </div>
                </div>
              </li>
            {%- endfor -%}
          </ul>

          <div class="gg-cart__assure">
            <div>
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 3h4l2 3 2-3h4l3 6-3 1v11H6V10L3 9l3-6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/></svg>
              <p><strong>Made to order for you.</strong> Each piece is handmade after you order and ready to ship in 5–8 working days. Because it's made for you, all sales are final.</p>
            </div>
          </div>
        </div>

        <aside class="gg-cart__summary">
          <div class="gg-sum">
            <p class="gg-sum__title">Order summary</p>
            <div class="gg-sum__row"><span>Subtotal</span><span>{{ cart.items_subtotal_price | money }}</span></div>
            {%- for discount in cart.cart_level_discount_applications -%}
              <div class="gg-sum__row gg-sum__row--discount"><span>{{ discount.title }}</span><span>−{{ discount.total_allocated_amount | money }}</span></div>
            {%- endfor -%}
            <div class="gg-sum__row gg-sum__row--muted"><span>Shipping</span><span>Calculated at checkout</span></div>
            <div class="gg-sum__total"><span>Total</span><span>{{ cart.total_price | money_with_currency }}</span></div>

            <details class="gg-sum__note" {% if cart.note != blank %}open{% endif %}>
              <summary>Add a note for our tailors <span aria-hidden="true">+</span></summary>
              <textarea name="note" rows="3" placeholder="e.g. event date, delivery instructions, fit preferences">{{ cart.note }}</textarea>
            </details>

            <button type="submit" name="checkout" class="gg-btn gg-btn--primary gg-sum__checkout">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 1 1 8 0v3" stroke="currentColor" stroke-width="1.6"/></svg>
              Secure checkout
            </button>
            {%- if additional_checkout_buttons and section.settings.show_express -%}
              <div class="gg-sum__express">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}

            {%- if shop.enabled_payment_types.size > 0 -%}
              <ul class="gg-sum__pay" role="list" aria-label="Accepted payment methods">
                {%- for type in shop.enabled_payment_types -%}<li>{{ type | payment_type_svg_tag }}</li>{%- endfor -%}
              </ul>
            {%- endif -%}

            <ul class="gg-sum__trust" role="list">
              <li>Worldwide shipping, with rates shown at checkout</li>
              <li>Secure, encrypted payment</li>
              <li>Questions? <a href="https://wa.me/2347048522079?text={{ wa }}" target="_blank" rel="noopener">Chat with us on WhatsApp</a></li>
            </ul>
          </div>
        </aside>
      </form>

      {%- comment -%} Mobile sticky checkout {%- endcomment -%}
      <div class="gg-cart__sticky">
        <div><span>Total</span><strong>{{ cart.total_price | money }}</strong></div>
        <button type="submit" form="gg-cart-form" name="checkout" class="gg-btn gg-btn--primary">Checkout</button>
      </div>
    {%- else -%}
      <div class="gg-cart__empty">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8L5 8Z" stroke="currentColor" stroke-width="1.3"/><path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.3"/></svg>
        <h2 class="gg-section-title">Your bag is empty</h2>
        <p class="gg-section-sub">Find something you'll love: every piece is made to your measure.</p>
        <div class="gg-cart__empty-links">
          <a class="gg-btn gg-btn--primary" href="{{ routes.all_products_collection_url }}">Shop all</a>
          {%- assign empty_handles = section.settings.empty_links | default: 'dresses,corset-tops-skirts,kimono' | remove: ' ' | split: ',' -%}
          {%- for h in empty_handles -%}
            {%- assign c = collections[h] -%}
            {%- if c != blank -%}<a class="gg-btn gg-btn--secondary" href="{{ c.url }}">{{ c.title }}</a>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if rec != blank and rec.products_count > 0 -%}
      <div class="gg-cart__rec">
        <h2 class="gg-section-title">{% if cart.item_count > 0 %}Complete the look{% else %}Trending now{% endif %}</h2>
        <ul class="gg-cart__rec-grid" role="list">
          {%- assign shown = 0 -%}
          {%- for p in rec.products -%}
            {%- assign in_cart = false -%}
            {%- for item in cart.items -%}{%- if item.product_id == p.id -%}{%- assign in_cart = true -%}{%- endif -%}{%- endfor -%}
            {%- unless in_cart -%}
              <li>{% render 'gg-product-card', product: p, sizes: '(max-width: 768px) 50vw, 25vw' %}</li>
              {%- assign shown = shown | plus: 1 -%}
              {%- if shown == 4 -%}{%- break -%}{%- endif -%}
            {%- endunless -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #gg-cart-{{ section.id }} { padding: 40px 0 80px; }
  #gg-cart-{{ section.id }} .gg-cart__head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
  #gg-cart-{{ section.id }} .gg-cart__title { margin: 0; font-family: var(--font-heading-family); font-weight: 400; font-size: clamp(32px, 3.6vw, 48px); color: #1d1a16; }
  #gg-cart-{{ section.id }} .gg-cart__title span { color: #8a7350; font-size: 0.6em; }
  #gg-cart-{{ section.id }} .gg-cart__continue { font-size: 14px; color: #6b5b3e; }

  #gg-cart-{{ section.id }} .gg-cart__layout { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 40px; align-items: start; }
  #gg-cart-{{ section.id }} .gg-cart__list { list-style: none; margin: 0; padding: 0; border-top: 1px solid #eee5d6; }
  #gg-cart-{{ section.id }} .gg-line { display: grid; grid-template-columns: 130px minmax(0, 1fr); gap: 20px; padding: 22px 0; border-bottom: 1px solid #eee5d6; }
  #gg-cart-{{ section.id }} .gg-line__img { display: block; aspect-ratio: 3 / 4; border-radius: 8px; overflow: hidden; background: #f1ebe0; }
  #gg-cart-{{ section.id }} .gg-line__img img { width: 100%; height: 100%; object-fit: cover; object-position: center 20%; }
  #gg-cart-{{ section.id }} .gg-line__info { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  #gg-cart-{{ section.id }} .gg-line__top { display: flex; justify-content: space-between; gap: 16px; }
  #gg-cart-{{ section.id }} .gg-line__name { font-size: 17px; font-weight: 500; color: #1d1a16; text-decoration: none; line-height: 1.35; }
  #gg-cart-{{ section.id }} .gg-line__price { font-size: 16px; font-weight: 600; color: #1d1a16; white-space: nowrap; }
  #gg-cart-{{ section.id }} .gg-line__variant { margin: 0; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; color: #5c554a; }
  #gg-cart-{{ section.id }} .gg-line__variant strong { color: #1d1a16; font-weight: 500; }
  #gg-cart-{{ section.id }} .gg-line__prop {
    margin: 2px 0 0; padding: 8px 10px; border-radius: 8px; background: #fbf8f2; border: 1px solid #efe6d4;
    font-size: 13px; color: #4a443b; line-height: 1.45;
  }
  #gg-cart-{{ section.id }} .gg-line__prop span { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8a7350; margin-bottom: 2px; }
  #gg-cart-{{ section.id }} .gg-line__unit { margin: 0; font-size: 13px; color: #8a8174; }
  #gg-cart-{{ section.id }} .gg-line__actions { display: flex; align-items: center; gap: 18px; margin-top: auto; padding-top: 8px; }
  #gg-cart-{{ section.id }} .gg-qty { display: inline-flex; align-items: center; border: 1px solid #ddd2bf; border-radius: 999px; overflow: hidden; }
  #gg-cart-{{ section.id }} .gg-qty__btn { width: 40px; height: 40px; border: 0; background: #fff; font-size: 18px; cursor: pointer; color: #1d1a16; }
  #gg-cart-{{ section.id }} .gg-qty__btn:hover { background: #f6f0e6; }
  #gg-cart-{{ section.id }} .gg-qty__input { width: 40px; height: 40px; border: 0; text-align: center; font-size: 15px; -moz-appearance: textfield; }
  #gg-cart-{{ section.id }} .gg-qty__input::-webkit-outer-spin-button, #gg-cart-{{ section.id }} .gg-qty__input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  #gg-cart-{{ section.id }} .gg-line__remove { font-size: 13px; color: #6b5b3e; }
  #gg-cart-{{ section.id }}.is-updating .gg-cart__layout { opacity: 0.55; pointer-events: none; transition: opacity 0.2s; }

  #gg-cart-{{ section.id }} .gg-cart__assure { margin-top: 20px; padding: 16px 18px; border-radius: 12px; background: #fbf8f2; border: 1px solid #efe6d4; }
  #gg-cart-{{ section.id }} .gg-cart__assure > div { display: flex; gap: 12px; align-items: flex-start; }
  #gg-cart-{{ section.id }} .gg-cart__assure svg { flex-shrink: 0; color: #6b5b3e; margin-top: 2px; }
  #gg-cart-{{ section.id }} .gg-cart__assure p { margin: 0; font-size: 14px; line-height: 1.55; color: #4a443b; }

  #gg-cart-{{ section.id }} .gg-cart__summary { position: sticky; top: 24px; }
  #gg-cart-{{ section.id }} .gg-sum { padding: 24px; border-radius: 14px; background: #f6f0e6; }
  #gg-cart-{{ section.id }} .gg-sum__title { margin: 0 0 16px; font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #8a7350; }
  #gg-cart-{{ section.id }} .gg-sum__row { display: flex; justify-content: space-between; gap: 12px; padding: 6px 0; font-size: 15px; color: #1d1a16; }
  #gg-cart-{{ section.id }} .gg-sum__row--muted { color: #6b6457; font-size: 14px; }
  #gg-cart-{{ section.id }} .gg-sum__row--discount { color: #1f7a4a; }
  #gg-cart-{{ section.id }} .gg-sum__total { display: flex; justify-content: space-between; gap: 12px; margin-top: 10px; padding-top: 14px; border-top: 1px solid #e2d6bf; font-size: 19px; font-weight: 600; }
  #gg-cart-{{ section.id }} .gg-sum__note { margin: 18px 0 4px; }
  #gg-cart-{{ section.id }} .gg-sum__note summary { list-style: none; display: flex; justify-content: space-between; cursor: pointer; font-size: 14px; color: #1d1a16; padding: 8px 0; }
  #gg-cart-{{ section.id }} .gg-sum__note summary::-webkit-details-marker { display: none; }
  #gg-cart-{{ section.id }} .gg-sum__note[open] summary span { transform: rotate(45deg); }
  #gg-cart-{{ section.id }} .gg-sum__note textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid #ddd2bf; border-radius: 8px; font-size: 15px; resize: vertical; background: #fff; }
  #gg-cart-{{ section.id }} .gg-sum__checkout { width: 100%; gap: 10px; min-height: 54px; margin-top: 16px; font-size: 14px; }
  #gg-cart-{{ section.id }} .gg-sum__express { margin-top: 10px; }
  #gg-cart-{{ section.id }} .gg-sum__pay { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  #gg-cart-{{ section.id }} .gg-sum__pay svg { width: 38px; height: 24px; }
  #gg-cart-{{ section.id }} .gg-sum__trust { list-style: none; margin: 16px 0 0; padding: 14px 0 0; border-top: 1px solid #e2d6bf; display: grid; gap: 8px; font-size: 13px; color: #5c554a; }
  #gg-cart-{{ section.id }} .gg-sum__trust li::before { content: "✓"; color: #6b5b3e; margin-right: 8px; font-weight: 700; }
  #gg-cart-{{ section.id }} .gg-sum__trust a { color: #1f7a4a; font-weight: 600; }

  #gg-cart-{{ section.id }} .gg-cart__sticky { display: none; }

  #gg-cart-{{ section.id }} .gg-cart__empty { text-align: center; max-width: 600px; margin: 30px auto 20px; color: #6b5b3e; }
  #gg-cart-{{ section.id }} .gg-cart__empty-links { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-top: 24px; }

  #gg-cart-{{ section.id }} .gg-cart__rec { margin-top: 64px; }
  #gg-cart-{{ section.id }} .gg-cart__rec .gg-section-title { text-align: center; margin-bottom: 28px; }
  #gg-cart-{{ section.id }} .gg-cart__rec-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }

  @media (max-width: 989px) {
    #gg-cart-{{ section.id }} .gg-cart__layout { grid-template-columns: 1fr; gap: 24px; }
    #gg-cart-{{ section.id }} .gg-cart__summary { position: static; }
  }
  @media (max-width: 768px) {
    #gg-cart-{{ section.id }} { padding: 24px 0 110px; }
    #gg-cart-{{ section.id }} .gg-cart__continue { display: none; }
    #gg-cart-{{ section.id }} .gg-line { grid-template-columns: 96px minmax(0, 1fr); gap: 14px; padding: 18px 0; }
    #gg-cart-{{ section.id }} .gg-line__top { flex-direction: column; gap: 2px; }
    #gg-cart-{{ section.id }} .gg-line__name { font-size: 15px; }
    #gg-cart-{{ section.id }} .gg-qty__btn, #gg-cart-{{ section.id }} .gg-qty__input { width: 36px; height: 36px; }
    #gg-cart-{{ section.id }} .gg-sum { padding: 20px; }
    #gg-cart-{{ section.id }} .gg-cart__rec-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 12px; }
    #gg-cart-{{ section.id }} .gg-cart__sticky {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 9990;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); background: #fff;
      border-top: 1px solid #eee; box-shadow: 0 -6px 20px rgba(0, 0, 0, 0.08);
    }
    #gg-cart-{{ section.id }} .gg-cart__sticky span { display: block; font-size: 12px; color: #6b6457; }
    #gg-cart-{{ section.id }} .gg-cart__sticky strong { font-size: 17px; }
    #gg-cart-{{ section.id }} .gg-cart__sticky .gg-btn { min-height: 48px; padding: 0 28px; }
  }
</style>

<script>
  (function() {
    var root = document.getElementById('gg-cart-{{ section.id }}');
    var form = document.getElementById('gg-cart-form');
    if (!root || !form) return;
    var timer = null;
    function update() {
      clearTimeout(timer);
      timer = setTimeout(function() {
        root.classList.add('is-updating');
        // Posting the form without "checkout" updates quantities/note and reloads the cart page
        form.submit();
      }, 450);
    }
    root.querySelectorAll('.gg-qty').forEach(function(q) {
      var input = q.querySelector('input');
      q.querySelectorAll('.gg-qty__btn').forEach(function(b) {
        b.addEventListener('click', function() {
          input.value = Math.max(0, (parseInt(input.value, 10) || 0) + parseInt(b.getAttribute('data-step'), 10));
          update();
        });
      });
      input.addEventListener('change', update);
    });
    // Save the note quietly (no reload) so it is kept when going to checkout
    var note = form.querySelector('textarea[name="note"]');
    if (note) note.addEventListener('change', function() {
      fetch('{{ routes.cart_update_url }}.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ note: note.value }) });
    });
  })();
</script>

{% schema %}
{
  "name": "Getglow cart",
  "settings": [
    { "type": "collection", "id": "recommend_collection", "label": "'Complete the look' collection", "info": "Defaults to Dresses / Bubu." },
    { "type": "checkbox", "id": "show_express", "label": "Show express checkout buttons", "default": true },
    { "type": "text", "id": "empty_links", "label": "Collections linked when the bag is empty (handles)", "default": "dresses,corset-tops-skirts,kimono" }
  ]
}
{% endschema %}
