<section class="gg-steps" id="gg-steps-{{ section.id }}">
  <div class="gg-wrap">
    <div class="gg-section-head">
      {%- if section.settings.heading != blank -%}<h2 class="gg-section-title">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.subheading != blank -%}<p class="gg-section-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <ol class="gg-steps__list">
      {%- for block in section.blocks -%}
        <li class="gg-step" {{ block.shopify_attributes }}>
          <span class="gg-step__num">{{ forloop.index }}</span>
          <h3 class="gg-step__title">{{ block.settings.title }}</h3>
          <p class="gg-step__text">{{ block.settings.text }}</p>
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.button_label != blank -%}
      <div class="gg-steps__cta">
        <a class="gg-btn gg-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% render 'gg-shared-styles' %}
<style>
  #gg-steps-{{ section.id }} { padding: 72px 0; background: {{ section.settings.background }}; }
  #gg-steps-{{ section.id }} .gg-steps__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_most: 4 | at_least: 1 }}, minmax(0, 1fr));
    gap: 24px;
  }
  #gg-steps-{{ section.id }} .gg-step {
    padding: 28px 24px;
    background: #fff;
    border: 1px solid #ece3d2;
    border-radius: 12px;
    text-align: center;
  }
  #gg-steps-{{ section.id }} .gg-step__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: #6b5b3e;
    color: #fff;
    font-size: 18px;
    font-weight: 600;
  }
  #gg-steps-{{ section.id }} .gg-step__title { margin: 0 0 8px; font-size: 18px; font-weight: 600; color: #1d1a16; }
  #gg-steps-{{ section.id }} .gg-step__text { margin: 0; font-size: 15px; line-height: 1.6; color: #5c554a; }
  #gg-steps-{{ section.id }} .gg-steps__cta { text-align: center; margin-top: 32px; }

  @media (max-width: 768px) {
    #gg-steps-{{ section.id }} { padding: 48px 0; }
    #gg-steps-{{ section.id }} .gg-steps__list { grid-template-columns: 1fr; gap: 12px; }
    #gg-steps-{{ section.id }} .gg-step {
      display: grid;
      grid-template-columns: 44px 1fr;
      column-gap: 16px;
      text-align: left;
      padding: 18px;
    }
    #gg-steps-{{ section.id }} .gg-step__num { grid-row: span 2; margin: 0; }
  }
</style>

{% schema %}
{
  "name": "Getglow how it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "How made-to-order works" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every piece is made for you, not pulled from a shelf." },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f6f0e6" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Getglow how it works" }]
}
{% endschema %}
